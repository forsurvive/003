# 월드 발견 자리 — 여의도·영등포(R02).

# 여의도 환승센터 터(L-R02-28) 계엄군 임시 초소(SD-03a §8.4 S1 · SD-09a L-R02-02 ② '해치 서쪽 6타일 초소, 그 앞 호송차').
# 호송차 철창 안 하도윤(V_DOYUN 1) · 경비 둘 · 선우진 중위(수색조를 이끌고 내려가면 비고, 말로 돌려보내면 돌아온다).
spot L-R02-28 12 7 off=-14,-2
prop convoy_truck_p 1 1 cond="V_DOYUN == 1 and MQ104_DOYUN == 0"
prop convoy_truck 1 1 cond="MQ104_DOYUN == 1"
text 1 2 "계엄군 호송차." w=3 scene=MQ-104_TRUCK
prop guard_booth 9 1
text 9 1 "임시 초소. 무전기와 근무 일지, 열쇠 걸이." scene=MQ-104_TRUCK
prop sandbags 8 3
prop sandbags 10 3
prop sandbags 11 3
npc CR-401 0 5 E sheet=en_cr401_loco cond="MQ104_GUARDS == 0 and MQ104_DOYUN == 0 and V_DOYUN == 1 and MQ104_SEARCH != 4" bark="호송차에 가까이 오지 마십시오."
npc CR-401 5 5 W sheet=en_cr401_loco cond="MQ104_GUARDS == 0 and MQ104_DOYUN == 0 and V_DOYUN == 1 and MQ104_SEARCH != 4" bark="계엄 구역입니다. 지나가십시오."
# 선우진을 말로 돌려보냈으면(SD-03a §8.4 기울기 체감) 초소 병사들이 "관리자 후보"라 부르며 검문 없이 지나가게 한다.
npc CR-401 0 5 E sheet=en_cr401_loco cond="MQ104_GUARDS == 0 and MQ104_DOYUN == 0 and V_DOYUN == 1 and MQ104_SEARCH == 4" bark="관리자 후보님. 검문 없이 지나가십시오. …호송차에는 가까이 오지 마시고요."
npc CR-401 5 5 W sheet=en_cr401_loco cond="MQ104_GUARDS == 0 and MQ104_DOYUN == 0 and V_DOYUN == 1 and MQ104_SEARCH == 4" bark="중위님 말씀 들었습니다. 전원이 들어오면 다시 뵙자고요."
npc C-034 9 4 S cond="MQ104_SEARCH == 0 or MQ104_SEARCH == 4"
mark truck_door 3 4 N
mark guard_a 0 5 E
mark guard_b 5 5 W

# 신도림 환승 고가(L-R02-24, SD-09a C · 단계 1-6 R02 남쪽 탐험 묶음): 2077년 출근 인파가 버린 우산 수백 개가 한쪽으로 쌓여 바리케이드가 됐다.
# 인솔조 운송로가 고가 아래를 지난다(매복 지점 — 인카운터 표가 맡는다). 우산 사이에 누가 숨겨 둔 보따리.
spot L-R02-24 10 4 off=9,1
prop umbrella_pile 0 1
prop umbrella_pile 3 1
prop umbrella_pile 7 1
text 0 1 "우산 바리케이드. 접힌 우산 수백 개가 손잡이끼리 엉켰다. 2077년 10월 24일 아침 출근길의 우산들이다." w=10
prop remains 6 3
text 6 3 "우산 하나를 쥔 채 엎드린 유해. 정기권 지갑에 '신도림 → 여의도'." scene=R02-24_COMMUTER
prop backpack 9 3
box 9 3 bag name="우산 사이 보따리"
text 9 3 "우산 더미 사이에 밀어 넣은 보따리. 끈에 붉은 번호표 '214'." 

# 무너진 국회 앞마당(L-R02-01 · 1-11j SQ-S11, SD-09a '앞마당 잔디밭' · SD-04a §5.4 낭독 자리). 정문(758,1058) 바로 앞 줄에 무너진 계단 열한 칸(낭독 — 칸마다 유인물),
# 마당에 LR-11을 쥔 해골(발동 ③) · 쓰러진 깃대(원본 b면 휘장 깃발) · 돔에서 떨어진 동판 조각 · 들개(원문 왕개미 — 그림 · 자료 이월, SD-14 정합).
spot @752,1060 13 4
prop kh_column 0 0
prop kh_column 12 0
text 12 0 "꺾이지 않은 열주 하나. 대리석에 총알 자국이 줄지어 박혔다."
prop kh_stairs_step 1 0
prop kh_stairs_step 2 0
prop kh_stairs_step 3 0
prop kh_stairs_step 4 0
prop kh_stairs_step 5 0
prop kh_stairs_step 6 0
prop kh_stairs_step 7 0
prop kh_stairs_step 8 0
prop kh_stairs_step 9 0
prop kh_stairs_step 10 0
prop kh_stairs_step 11 0
text 1 0 "무너진 정면 계단." w=11 scene=SQS11_STEPS
mark kh_steps 1 0 S
mark kh_read 6 2 N
prop kh_flag 9 2
text 9 2 "깃대." w=2 scene=SQS11_FLAG
mark kh_flag 9 2 S
prop bone_pile 1 3

spot L-R02-01 9 6 off=-4,8
prop kh_dome_chunk 0 0
text 1 0 "돔에서 떨어져 나온 녹청 동판 조각. 안쪽 늑재에 '1975'가 새겨져 있다." w=2
prop remains 5 3
text 5 3 "잔디 속에 엎드린 해골." scene=SQS11_SKEL
enemy CR-104 1 5
enemy CR-104 8 5

# 1-11l SQ-S13 볼트 S-02(L-R02-04, SD-09a L924): 여의도공원 남쪽 숲 — 환기탑 · 2077 동판(반쯤 묻힌 톱니 문은 world_chunks 문).
spot L-R02-04 8 5 off=3,-4
prop vent_tower 0 0
text 0 2 "볼트 환기탑. 철망 틈으로 낮게 웅웅 — 안에서 방송이 새어 나온다. '…소중한 한 표를 행사합시다.'" w=2 cond="SQ_S13_BOARD != 2"
text 0 2 "볼트 환기탑. 새어 나오는 방송이 달라졌다 — '임기 4년. 다음 선거는 1,460일 뒤입니다.'" w=2 cond="SQ_S13_BOARD == 2"
text 4 4 "풀에 덮인 동판. '서울 볼트 S-02 여의도 — 국회 인력 보존(2077).' 누가 '국회' 두 글자만 손으로 닦아 놓았다." w=2

# 1-11l SQ-S13 영등포 역전 시장(L-R02-12, SD-09a L983): 지하시장의 지상 시장 — 인간 상인 · 시장 반장 탁우빈(N-R02-019) · 총포상 표강윤(N-R02-020).
#   아치 간판 '영등포시장 — 전시 공동 구매 협력 시장' · 칠판 '오늘 들어온 물건' · 노점 넷. 낮(06~20시)에만 장이 선다.
#   유권자로 S-02에 가 있으면(V 2 · 3) 그 자리가 빈다(P3 — 인물 한 곳).
spot L-R02-12 15 9 off=-7,-4
prop market_arch 6 0
text 6 1 "아치 간판 '영등포시장 — 전시 공동 구매 협력 시장'. 기둥에 감은 전선에 전구 몇 개가 아직 들어온다." w=3
prop stall_food 1 3
prop stall_parts 4 5
prop stall_clothes 10 3
prop stall_meds 12 6
prop price_board 7 6
text 7 6 "칠판 '오늘 들어온 물건'. 소금 · 비누 · 전지(재생) · 10mm 탄. 맨 아래 '자릿세는 반장에게'." w=2 cond="SQ_S13_V_T != 4 and UQ10_BOSS == 0 and dead(\"N-R02-019\") == 0"
text 7 6 "칠판 '오늘 들어온 물건'. 소금 · 비누 · 전지(재생) · 10mm 탄. 맨 아래 새 줄 — '한 표(반장)'." w=2 cond="SQ_S13_V_T == 4 and UQ10_BOSS == 0 and dead(\"N-R02-019\") == 0"
text 7 6 "칠판 '오늘 들어온 물건'. 맨 아래 줄을 지우고 새로 — '자릿세: 상인 회의 저울'. 그 옆에 검은 띠 한 줄." w=2 cond="UQ10_BOSS == 0 and dead(\"N-R02-019\") == 1"
text 7 6 "칠판 '오늘 들어온 물건'. 맨 아래 줄을 지우고 새로 — '자릿세는 상인 회의 저울로. 반장 표강윤'." w=2 cond="UQ10_BOSS == 1 and dead(\"N-R02-020\") == 0"
text 7 6 "칠판 '오늘 들어온 물건'. '반장 표강윤' 위에 검은 띠. 그 밑에 '반장은 돌아가며'." w=2 cond="UQ10_BOSS == 1 and dead(\"N-R02-020\") == 1"
text 7 6 "칠판 '오늘 들어온 물건'. 맨 아래 줄을 지우고 새로 — '자릿세는 상인 회의 저울로. 반장은 돌아가며'." w=2 cond="UQ10_BOSS == 2"
text 1 4 "먹거리 노점. 솥에서 김. 간판 없이 '국밥 6캡'." w=2
npc N-R02-019 8 4 S cond="GAME_HOUR >= 6 and GAME_HOUR < 20 and SQ_S13_V_T != 2 and SQ_S13_V_T != 3 and UQ10_BOSS == 0" bark="지상은 사람, 지하는 구울. 자릿세는 똑같이 받지."
npc N-R02-020 13 4 W cond="GAME_HOUR >= 6 and GAME_HOUR < 20 and SQ_S13_V_P != 2 and SQ_S13_V_P != 3 and UQ10_BOSS != 1" bark="10mm는 오늘 들어왔어. 값은 어제랑 같고."
npc N-R02-020 13 4 W cond="GAME_HOUR >= 6 and GAME_HOUR < 20 and SQ_S13_V_P != 2 and SQ_S13_V_P != 3 and UQ10_BOSS == 1" bark="반장 노릇은 처음이야. 저울은 상인 회의 검정. 10mm는 여전히 내 노점에서."
text 8 4 "반장 자리에 쪽지 — '투표하러 감. 자릿세는 내일. 탁우빈'." cond="(SQ_S13_V_T == 2 or SQ_S13_V_T == 3) and UQ10_BOSS == 0"
text 13 4 "총포상 덧문이 내려졌다. 분필로 '볼트 투표 — 한 발 쏘고 옴'." cond="SQ_S13_V_P == 2 or SQ_S13_V_P == 3"
# 1-12h UQ-10 「저울추」(SD-05 §3.4 · 계획 §3.2b): 노점 상인 둘(국밥 장수 N-YM-1 · 부품 장수 N-YM-2 — 낮 노점 뒤, 상점 VR12F · VR12P) · 반장 추 저울(9,5) · 덤 고철 더미 ·
#   쫓겨난 탁우빈의 구석 노점(2,7) · 습격 전날 어귀의 대방 정찰 둘(출처 — P7) · 털린 노점 흔적. 사실은 원고 UQ-10.txt 머리 주석(쇠판 · 반장 · 습격 한 값).
npc N-YM-1 2 2 S look=F2-S1-HR08-H4-T10-1-PF00-HD00-EY00 cond="GAME_HOUR >= 6 and GAME_HOUR < 20 and dead(\"N-YM-1\") == 0 and (UQ10_RES == 2 and (UQ10_RAID == 2 or UQ10_RAID == 4))" bark="남쪽 노점이 털렸어. …국밥 솥은 무사해. 솥까진 못 들고 가더라."
npc N-YM-1 2 2 S look=F2-S1-HR08-H4-T10-1-PF00-HD00-EY00 cond="GAME_HOUR >= 6 and GAME_HOUR < 20 and dead(\"N-YM-1\") == 0 and ((UQ10_RES == 2 and UQ10_RAID == 0 and UQ10_RAID_DAY > 0 and GAME_DAY == UQ10_RAID_DAY - 1) and not ((UQ10_RES == 2 and (UQ10_RAID == 2 or UQ10_RAID == 4))))" bark="(국자를 쥔 채 어귀를 흘끔거린다) 손님이 셋뿐이야."
npc N-YM-1 2 2 S look=F2-S1-HR08-H4-T10-1-PF00-HD00-EY00 cond="GAME_HOUR >= 6 and GAME_HOUR < 20 and dead(\"N-YM-1\") == 0 and ((UQ10_RES == 2 and UQ10_BOSS >= 1) and not ((UQ10_RES == 2 and (UQ10_RAID == 2 or UQ10_RAID == 4)) or (UQ10_RES == 2 and UQ10_RAID == 0 and UQ10_RAID_DAY > 0 and GAME_DAY == UQ10_RAID_DAY - 1)))" bark="새 저울로 다니까 국밥값이 남아. 한 그릇 해."
npc N-YM-1 2 2 S look=F2-S1-HR08-H4-T10-1-PF00-HD00-EY00 cond="GAME_HOUR >= 6 and GAME_HOUR < 20 and dead(\"N-YM-1\") == 0 and ((UQ10_RES == 4) and not ((UQ10_RES == 2 and (UQ10_RAID == 2 or UQ10_RAID == 4)) or (UQ10_RES == 2 and UQ10_RAID == 0 and UQ10_RAID_DAY > 0 and GAME_DAY == UQ10_RAID_DAY - 1) or (UQ10_RES == 2)))" bark="(고철 자루를 들었다 놓는다) 또 가벼워졌어."
npc N-YM-1 2 2 S look=F2-S1-HR08-H4-T10-1-PF00-HD00-EY00 cond="GAME_HOUR >= 6 and GAME_HOUR < 20 and dead(\"N-YM-1\") == 0 and ((UQ10_PLATE == 2 and GAME_DAY > UQ10_PLATE_DAY and (UQ10_RES == 0 or UQ10_RES == 6)) and not ((UQ10_RES == 2 and (UQ10_RAID == 2 or UQ10_RAID == 4)) or (UQ10_RES == 2 and UQ10_RAID == 0 and UQ10_RAID_DAY > 0 and GAME_DAY == UQ10_RAID_DAY - 1) or (UQ10_RES == 2) or (UQ10_RES == 4)))" bark="오늘 저울 후하네? 고철 한 관에 한 관 반 값이야!"
npc N-YM-1 2 2 S look=F2-S1-HR08-H4-T10-1-PF00-HD00-EY00 cond="GAME_HOUR >= 6 and GAME_HOUR < 20 and dead(\"N-YM-1\") == 0 and ((1 == 1) and not ((UQ10_RES == 2 and (UQ10_RAID == 2 or UQ10_RAID == 4)) or (UQ10_RES == 2 and UQ10_RAID == 0 and UQ10_RAID_DAY > 0 and GAME_DAY == UQ10_RAID_DAY - 1) or (UQ10_RES == 2) or (UQ10_RES == 4) or (UQ10_PLATE == 2 and GAME_DAY > UQ10_PLATE_DAY and (UQ10_RES == 0 or UQ10_RES == 6))))" bark="국밥 6캡. 솥 안 식었어. 고철로 내면 반장 저울에 달고."
npc N-YM-2 4 4 S look=M1-S3-HR02-H1-T16-2-PF00-HD03-EY00 cond="GAME_HOUR >= 6 and GAME_HOUR < 20 and dead(\"N-YM-2\") == 0 and (UQ10_ROB_DAY > 0 and GAME_DAY - UQ10_ROB_DAY < 3)" bark="(쪼개진 판자를 나른다) 못이 모자라."
npc N-YM-2 4 4 S look=M1-S3-HR02-H1-T16-2-PF00-HD03-EY00 cond="GAME_HOUR >= 6 and GAME_HOUR < 20 and dead(\"N-YM-2\") == 0 and ((UQ10_HIDE_UNTIL >= GAME_DAY and UQ10_HEARD == 1 and (UQ10_RES == 0 or UQ10_RES == 6)) and not ((UQ10_ROB_DAY > 0 and GAME_DAY - UQ10_ROB_DAY < 3)))" bark="(저울 쪽을 흘끔) 10캡이 나오네?"
npc N-YM-2 4 4 S look=M1-S3-HR02-H1-T16-2-PF00-HD03-EY00 cond="GAME_HOUR >= 6 and GAME_HOUR < 20 and dead(\"N-YM-2\") == 0 and ((UQ10_RES == 4) and not ((UQ10_ROB_DAY > 0 and GAME_DAY - UQ10_ROB_DAY < 3) or (UQ10_HIDE_UNTIL >= GAME_DAY and UQ10_HEARD == 1 and (UQ10_RES == 0 or UQ10_RES == 6))))" bark="4캡이라니. 지난달엔 5캡이었어."
npc N-YM-2 4 4 S look=M1-S3-HR02-H1-T16-2-PF00-HD03-EY00 cond="GAME_HOUR >= 6 and GAME_HOUR < 20 and dead(\"N-YM-2\") == 0 and ((1 == 1) and not ((UQ10_ROB_DAY > 0 and GAME_DAY - UQ10_ROB_DAY < 3) or (UQ10_HIDE_UNTIL >= GAME_DAY and UQ10_HEARD == 1 and (UQ10_RES == 0 or UQ10_RES == 6)) or (UQ10_RES == 4)))" bark="볼트 쓸 거 있어? 구리선은 오늘 들어왔어."
prop scale_beam 9 5 cond="UQ10_PLATE == 0 and UQ10_HIDE_UNTIL < GAME_DAY and UQ10_RES != 3 and not (UQ10_RES == 2 and UQ10_BOSS >= 1)"
prop scale_beam 9 5 state=swap cond="UQ10_PLATE == 2 and UQ10_RES != 3 and not (UQ10_RES == 2 and UQ10_BOSS >= 1)"
prop scale_beam 9 5 state=fixed cond="(UQ10_RES == 2 and UQ10_BOSS >= 1) or UQ10_RES == 3 or (UQ10_RES != 2 and (UQ10_PLATE == 1 or (UQ10_PLATE == 0 and UQ10_HIDE_UNTIL >= GAME_DAY)))"
text 9 5 "반장 추 저울." w=2 scene=UQ10_SCALE
prop scrap_pile 6 3 cond="UQ10_RES != 2 and UQ10_RES != 3"
text 6 3 "덤 고철 더미. 맨 위 자루에 분필 — '대방 — 목'." w=2 cond="UQ10_RES != 2 and UQ10_RES != 3 and not (UQ71_SQ == 9 and GAME_DAY > UQ71_SQ_DAY)"
text 6 3 "덤 고철 더미. 자루의 분필 '대방 — 목'에 줄이 그어지고 그 옆에 '2층'." w=2 cond="UQ10_RES != 2 and UQ10_RES != 3 and (UQ71_SQ == 9 and GAME_DAY > UQ71_SQ_DAY)"
text 6 3 "덤 더미가 치워진 자리. 바닥에 분필 '대방 — 목'이 반쯤 지워졌다." w=2 cond="UQ10_RES == 2 or UQ10_RES == 3"
prop tarp_pile 1 7 cond="UQ10_BOSS >= 1"
npc N-R02-019 2 7 E cond="GAME_HOUR >= 6 and GAME_HOUR < 20 and UQ10_BOSS >= 1 and SQ_S13_V_T != 2 and SQ_S13_V_T != 3 and not (UQ10_RES == 2 and UQ10_RAID == 0 and UQ10_RAID_DAY > 0 and GAME_DAY == UQ10_RAID_DAY - 1)" bark="(구석 노점 거적 위에 고철 몇 토막) 반장은 이제 내가 아니야. 난 고철 장수고."
npc N-R02-019 2 7 E cond="GAME_HOUR >= 6 and GAME_HOUR < 20 and UQ10_BOSS >= 1 and SQ_S13_V_T != 2 and SQ_S13_V_T != 3 and (UQ10_RES == 2 and UQ10_RAID == 0 and UQ10_RAID_DAY > 0 and GAME_DAY == UQ10_RAID_DAY - 1)" bark="(구석 노점에서 손가락으로 날을 센다) 목요일이 내일이지."
text 1 7 "구석 노점 거적 위에 쪽지 — '투표하러 감. 탁우빈'." cond="UQ10_BOSS >= 1 and (SQ_S13_V_T == 2 or SQ_S13_V_T == 3)"
npc N-DB-S1 5 1 S sheet=en_cr420_loco cond="GAME_HOUR >= 6 and GAME_HOUR < 20 and (UQ10_RES == 2 and UQ10_RAID == 0 and UQ10_RAID_DAY > 0 and GAME_DAY == UQ10_RAID_DAY - 1) and UQ71_SQ != 9" bark="(시장 안 노점을 손가락으로 센다) …넷. 덤 끊긴 놈들."
npc N-DB-S2 9 1 S sheet=en_cr420b_loco cond="GAME_HOUR >= 6 and GAME_HOUR < 20 and (UQ10_RES == 2 and UQ10_RAID == 0 and UQ10_RAID_DAY > 0 and GAME_DAY == UQ10_RAID_DAY - 1) and UQ71_SQ != 9" bark="(침을 뱉는다) 내일 아침에 보자고."
text 12 6 "약 노점 판자가 쪼개졌다. 진열대가 텅 비었다 — 대방 분대가 휩쓸고 갔다." w=2 cond="UQ10_ROB_DAY > 0 and GAME_DAY - UQ10_ROB_DAY < 3"

# 1-12h UQ-70 「대림 시장의 이자」 대림 장터(L-R02-18, SD-09a L1036~1041 · SD-21 F6 골목 시장 · 계획 §3.5 · §8d V1~V12): 시흥대로 · 도림로 · 가마산로 삼거리 곁.
#   골목 폭 하나 둘 — 북쪽 노점 줄(국수 · 천 씨 잡화 · 상인회 칠판 · 옷 노점) · 남쪽 번호표 창구 · 막다른 끝 넷(번호표 통 · 들것 정류지 · 둘째 몫 연장 좌판 · 무명 노점 둘의 물물교환).
#   '특정 집단을 묘사하지 않는다'(09a) — 간판 · 이름은 흔한 시장 결. 사실은 원고 UQ-70.txt 머리 주석(UQ70_ 변수 한 곳).
#   장은 07~19시. 이자(N-R02-047)는 수 · 토(GAME_WDAY 2 · 5) 09~17 창구 · 17~19 골목을 지나간다(소매치기 — 진행기 조사 키). 손지담 밤은 K-39 장터 사무실.
spot L-R02-18 16 11 off=1,-13
prop sd_tent_o 0 0
prop stall_food 0 3
text 0 3 "국수 노점. 양은 솥에서 김이 오른다. 판자에 분필 '잔치국수 5캡 · 비빔 6캡'." w=2
npc N-DR-3 1 2 S look=F2-S3-HR06-H2-T10-1-PF00-HD00-EY00 cond="GAME_HOUR >= 7 and GAME_HOUR < 19 and dead(\"N-DR-3\") == 0" bark="면은 어제 뽑았어. 국물은 오늘 거고."
prop tarp_pile 3 1 cond="UQ70_STALL_GONE == 0"
text 3 1 "거적 위에 지게 멜빵 하나 · 끌 · 망치 · 새끼줄 한 타래. 쪽지 '둘째 몫 — 팝니다'. 글씨가 한 번 지워졌다 다시 쓰였다." cond="UQ70_STALL_GONE == 0 and UQ70_RES == 0 and UQ70_SUHO != 1"
text 3 1 "거적 위 연장이 그대로다. 쪽지 '둘째 몫 — 팝니다'에 가위표. 그 밑에 '안 팝니다'." cond="UQ70_STALL_GONE == 0 and UQ70_RES != 0"
text 3 1 "거적 위 지게 멜빵만 덩그러니. 쪽지에 '둘째 — 본소'. 누가 그 밑에 '아직'이라고 덧썼다." cond="UQ70_STALL_GONE == 0 and UQ70_RES == 0 and UQ70_SUHO == 1"
prop stall_parts 3 3 cond="UQ70_STALL_GONE == 0"
text 3 3 "천 씨 잡화. 새끼줄 · 양동이 · 녹 벗긴 못 한 됫박 · 2077년 재고 건전지(죽은 것)." w=2 cond="UQ70_STALL_GONE == 0"
text 3 3 "빈 노점 자리. 각목 다리 자국 넷과 분필 '천 — 정리'. 옆 노점이 벌써 판자를 넓혔다." w=2 cond="UQ70_STALL_GONE == 1"
npc N-DR-1 4 2 S look=E1-S3-HR02-H4-T03-2-PF00-HD03-EY00 cond="GAME_HOUR >= 7 and GAME_HOUR < 19 and UQ70_STALL_GONE == 0 and UQ70_SUHO == 1" bark="(지게 끈만 만지작거린다) …본소 창고동 뒤에 사슬 기둥이 있대."
npc N-DR-1 4 2 S look=E1-S3-HR02-H4-T03-2-PF00-HD03-EY00 cond="GAME_HOUR >= 7 and GAME_HOUR < 19 and UQ70_STALL_GONE == 0 and UQ70_RES != 0 and UQ70_SUHO != 1" bark="둘째가 지게를 다시 졌어. 등이 펴졌더라."
npc N-DR-1 4 2 S look=E1-S3-HR02-H4-T03-2-PF00-HD03-EY00 cond="GAME_HOUR >= 7 and GAME_HOUR < 19 and UQ70_STALL_GONE == 0 and UQ70_RES == 0 and UQ70_SUHO != 1" bark="끈 하나 백 캡이 아니라 한 캡이야. …둘째가 메던 거지."
prop stamp_pole 5 3 cond="UQ70_GUARD < 2 and (UQ70_RES == 0 or UQ70_RES == 3) and (UQ70_DUE == 0 or dead(\"N-DR-2\") == 1)"
prop stamp_pole 5 3 state=red cond="UQ70_GUARD < 2 and UQ70_RES == 0 and UQ70_DUE > 0 and dead(\"N-DR-2\") == 0"
prop stamp_pole 5 3 state=guard cond="UQ70_GUARD == 2 or UQ70_RES == 2 or UQ70_RES == 4"
text 5 3 "도장 종이 기둥. '자릿세 납부 확인' 종이가 겹겹이 — 장마다 붉은 둥근 도장." cond="UQ70_GUARD < 2 and (UQ70_RES == 0 or UQ70_RES == 3) and UQ70_DUE == 0"
text 5 3 "도장 종이 기둥. 붉은 네모 도장 종이를 누가 반으로 접어 놓았다. 그 위에 검은 끈 한 가닥." cond="UQ70_GUARD < 2 and UQ70_RES == 0 and UQ70_DUE > 0 and dead(\"N-DR-2\") == 1"
text 5 3 "도장 종이 기둥. 눈높이에 새 종이 — 굵은 붉은 네모 도장 '인력 1 — 수 09'. 그 밑 작은 글씨 '천 둘째'." scene=UQ70_POLE cond="UQ70_GUARD < 2 and UQ70_RES == 0 and UQ70_DUE > 0 and UQ70_FLED == 0 and dead(\"N-DR-2\") == 0"
text 5 3 "도장 종이 기둥. 붉은 도장 위에 또 붉은 도장 — '인력 1 — 도주 · 수 09'. 이번엔 '천 둘째' 옆에 사슬 그림 두 겹." scene=UQ70_POLE cond="UQ70_GUARD < 2 and UQ70_RES == 0 and UQ70_DUE > 0 and UQ70_FLED == 1 and dead(\"N-DR-2\") == 0"
text 5 3 "도장 종이 기둥. 붉은 예고 도장 위를 청록 종이가 덮었다 — '지하시장 경호단 입회'. 테이프 네 귀퉁이." cond="UQ70_GUARD == 2"
text 5 3 "도장 종이 기둥. 붉은 도장 종이를 뜯어낸 자리에 상인회 새 종이 — '자릿세는 상인회 함으로'." cond="UQ70_GUARD < 2 and (UQ70_RES == 2 or UQ70_RES == 4)"
prop sd_tent_g 5 0
prop evac_sign 7 0
text 7 0 "골목 끝 표지판. 붉은 십자에 '들것 의료반 — 금요일 정류지'. 밑에 분필로 '요즘은 격주'." 
prop sd_tent_y 8 0
prop price_board 8 3
text 8 3 "상인회 칠판." w=2 scene=UQ70_BOARD
npc N-R02-046 10 3 W cond="GAME_HOUR >= 7 and GAME_HOUR < 19" bark="자릿세가 두 배야. 새벽인력은 장부로 때려."
prop stall_clothes 11 3
text 11 3 "옷 노점. 2077년 상표가 붙은 겨울 외투가 걸렸다. 값은 상표 말고 솜 두께로 매긴다." w=2
npc N-DR-7 12 2 S look=F1-S4-HR09-H1-T10-1-PF00-HD00-EY00 cond="GAME_HOUR >= 7 and GAME_HOUR < 19" bark="솜 두께 봐. 상표는 덤이야."
prop crate_o 14 0
prop drum 15 2
