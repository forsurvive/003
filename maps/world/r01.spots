# 월드 발견 자리 — 관악·봉천(R01). 문법: map_compile.compile_spots 참조(spot 줄 아래 명령은 구역 왼쪽 위 기준 좌표).

# 봉천 동 주민센터(L-R01-32) 앞 넘어진 파수(SD-03a §8.2 MQ-102 잠든 로봇 · SD-09a L-R01-32). 다가가면 한 번 깨어난다.
spot L-R01-32 12 3 off=-5,51                   # 장소 표 칸(906,1349)은 손 맵 X-BC 안 — 남쪽 관공서 건물(정면 문 908,1399 · K-33, 시험 test_sq_s04가 문과 자리를 맞춰 본다) 문 앞 콘크리트 마당
prop civil_post 0 0
text 0 0 "세움 간판 '봉천동 주민센터 · 민원실 1층'. 판 귀퉁이에 총탄 구멍 하나." w=3
mark sentry 9 0 S                              # 파수 그림은 진행기 SideS04가 세운다(잠듦 · 깨어남 · 잔해 — 1-11c)
trigger 2 0 w=9 h=3 scene=MQ-102_SENTRY cond="V_ACT >= 1 and MQ102_ROBOT == 0 and SQ_S04_UP == 0" once
text 9 0 "엎드린 경비 로봇." w=2 scene=MQ-102_SENTRY_AFTER

# 봉천 동 주민센터 동쪽 별채(흰 벽돌) 창고 창(1-12l D-100 — SD-04a §4.4 해법 C '뒤 창고 창문'): 별채와 옆 건물 사이 골목 입구(정문 파수 길에서 등진 쪽 —
#   골목을 따라 북쪽에서 다가오면 앞마당을 지나지 않는다. 재미 검수 ③). 창은 별채 벽 아랫단(왼쪽 한 칸), 조사는 골목 칸에서. [자물쇠 따기 25] → 민원실 창고(K-33 from_back)
spot @915,1399 1 1
prop annex_window -1 0 cond="SQ_S04_WIN == 0"
prop annex_window -1 0 state=open cond="SQ_S04_WIN == 1"
text 0 0 "별채 아랫단 창고 창. 녹슨 창살 셋, 걸쇠에 자물쇠 하나. 아래 자재 상자를 밟으면 손이 닿는다." scene=SQS04_WINDOW

# 관악 비탈 숲 틈 위(1-13j 경제 조율 — 조율사 보고 1 '첫 시간의 캡' · 1-13j2 재미 검수 반영, 계획 `docs/seoul-fallout/_plans/1-13j2_wander_tin_plan.md`):
#   떠돌이가 돌을 쌓아 틈을 막고 숨겨 둔 비상금 깡통 — 캡 20~25 한 번(아이템 없음). 볼트 앞마당(손 맵)을 지나 숲 틈을 빠져나오면 봉천 가는 흙길 북쪽 세 칸.
#   돌탑(wander_cairn — 산의 둥근 바위와 다른 납작한 층 · 깡통 뚜껑 반짝임) · 흙길에서 이어지는 군화 발자국. 글은 진행기 WanderTin이 용기를 열기 전에 띄운다(WT_STATE).
#   주인이 누구인지 · 왜 안 돌아왔는지는 말하지 않는다(사실을 늘리지 않음 — SD-20 P2).
spot @949,1459 2 2
prop wander_cairn 0 0 cond="WT_STATE == 0"
prop wander_cairn 0 0 state=scattered cond="WT_STATE == 1 or WT_STATE == 2"
prop wander_cairn 0 0 state=restacked cond="WT_STATE >= 3"
prop boot_prints 0 1
box 0 0 wander_tin name="바위 틈 탄약 깡통"

# 관악산 전망바위(L-R01-03, SD-09a B · 단계 1-5e): 데크 끝 동전 망원경 → 전망 장면(R01 전체 + 여의도 장소를 지도에 '표시').
# 2077 안내판 '맑은 날에는 여의도 국회 돔과 남산 타워가 보입니다' — 돔은 무너졌고 탑은 그대로라 절반만 맞다.
spot L-R01-03 7 4
prop telescope 3 1
text 3 1 "동전 망원경. 렌즈에 흙먼지가 앉았다." scene=K-03_VIEW
prop info_board 1 1
text 1 1 "2077 안내판. '맑은 날에는 여의도 국회 돔과 남산 타워가 보입니다.' 돔은 무너졌다. 탑은 그대로다."
prop bench 4 3
text 4 3 "쉼터 벤치. 등받이에 새긴 낙서 '2076. 10. 우리 여기서 처음 만남'." w=2

# 노량진 다리목 검문소(L-R01-20, SD-09a B · SD-03a §8.5 장부 인도처 · 단계 1-6): 계엄군 분대 초소. 엄도현 하사(N-R01-050)가 장부를 받는다.
# 정합: 다리 건너 판독기 구역·통행 판정은 2막 횡단(MQ-201)과 함께 — 지금은 초소와 사람만 선다.
spot L-R01-20 10 6
prop guard_booth 6 1
text 6 1 "계엄군 다리목 초소. 무전기와 판독기 대장, 탄띠." scene=MQ-105_BJ_IDLE cond="UQ03_EOM < 2 and dead(\"N-R01-050\") == 0"
text 6 1 "계엄군 다리목 초소. 무전기와 판독기 대장, 탄띠. 의자 등받이에 하사 계급장 자국." scene=UQ03_SUB cond="UQ03_EOM >= 2 or dead(\"N-R01-050\") == 1"
prop sandbags 1 3
prop sandbags 2 3
prop sandbags 7 3
prop sandbags 8 3
prop jersey 4 3
text 4 3 "콘크리트 차단벽. 스텐실 '계엄 구역 — 판독기 앞에서 정지'." 
# 엄도현 자리 한 값(UQ03_EOM — UQ-03.txt 머리): 0 · 1 초소 · 2 이상 떠남 → 그 자리에 무명 분대장(N-BJ-C2, CR-403 그림)
npc N-R01-050 5 4 S cond="UQ03_EOM < 2"
npc N-BJ-C2 6 4 S sheet=en_cr403_loco cond="UQ03_EOM >= 2 or dead(\"N-R01-050\") == 1"
npc CR-401 2 4 E sheet=en_cr401_loco cond="UQ03_PASS == 0 or UQ03_EOM != 0" bark="강 건너는 판독기 구역입니다. 등록증을 준비하십시오."
npc CR-401 2 4 E sheet=en_cr401_loco cond="UQ03_PASS == 1 and UQ03_EOM == 0 and dead(\"N-R01-050\") == 0" bark="(당신을 알아본다) 하사님 손님이시네. 지나가십시오."
npc CR-401 8 4 W sheet=en_cr401_loco cond="UQ03_EOM != 0 or dead(\"N-R01-050\") == 1 or stage(\"UQ-03\") != 0" bark="노량진 쪽 통행은 06시부터입니다."
npc CR-401 8 4 W sheet=en_cr401_loco cond="UQ03_EOM == 0 and dead(\"N-R01-050\") == 0 and stage(\"UQ-03\") == 0" bark="하사님은 교대 때나 사람 말을 하셔. 그 밖엔 판독기지."

# 노량진 수산시장(L-R01-25, SD-09a B · 단계 1-7c): 경매장 지붕 아래 좌판 · 원자력 냉동고(가동, 각성회 대기등 하나) · 생선 함지 · 2077 시세 칠판.
# 경매사 심도겸(N-R01-057) — 거래(VR25) · 냉동고 이야기(훅 H-R01-09 앞부분). 시장 뒤 터는 고정 매복 지점(SD-06 §12.3, 1-12 판도와 함께).
spot L-R01-25 11 7
# 1-12i UQ-66 「전지 하나, 냉장고 둘」(SD-05 §3.30): 냉동고 그림 셋(가동 · 붉은 천 꼬리표 '수거' · 멎음) — 전지가 빠졌는지는 UQ66_PULLED 한 값(P1).
#   기한 날(UQ66_DUE) 10~14시 각성회 운반조 둘 + 손수레 · 기한 전날 순례조가 지붕 밑에서 손수레 바퀴를 고친다(예고 — 출처).
prop freezer_unit 8 1 cond="UQ66_PULLED == 0 and UQ66_TAG == 0"
prop freezer_unit 8 1 state=tagged cond="UQ66_PULLED == 0 and UQ66_TAG == 1"
prop freezer_unit 8 1 state=off cond="UQ66_PULLED == 1"
text 8 2 "원자력 냉동고." w=2 scene=UQ66_FREEZER
prop hm_cart 9 3 cond="UQ66_DUE > 0 and GAME_DAY >= UQ66_DUE - 1 and GAME_DAY <= UQ66_DUE and UQ66_BATT == 0 and UQ66_GSCELL == 0 and SQH_BATT != 7"
npc N-GS-C1 8 3 N look=M1-S3-HR03-H2-T05-1-PF00-HD00-EY00 cond="UQ66_DUE > 0 and GAME_DAY == UQ66_DUE and GAME_HOUR >= 10 and GAME_HOUR < 14 and UQ66_BATT == 0 and UQ66_PULLED == 0 and UQ66_GSCELL == 0 and SQH_BATT != 7 and AFF_GS > -60"
npc N-GS-C2 10 4 N look=F1-S2-HR05-H3-T05-1-PF00-HD00-EY00 cond="UQ66_DUE > 0 and GAME_DAY == UQ66_DUE and GAME_HOUR >= 10 and GAME_HOUR < 14 and UQ66_BATT == 0 and UQ66_PULLED == 0 and UQ66_GSCELL == 0 and SQH_BATT != 7 and AFF_GS > -60 and dead(\"N-R01-055\") == 0" bark="(손수레 손잡이를 쥔 채) 당번장님 명이에요. 대기등이 먼저래요."
npc N-GS-C2 10 4 N look=F1-S2-HR05-H3-T05-1-PF00-HD00-EY00 cond="UQ66_DUE > 0 and GAME_DAY == UQ66_DUE and GAME_HOUR >= 10 and GAME_HOUR < 14 and UQ66_BATT == 0 and UQ66_PULLED == 0 and UQ66_GSCELL == 0 and SQH_BATT != 7 and AFF_GS > -60 and dead(\"N-R01-055\") == 1" bark="(손수레 손잡이를 쥔 채) 대기등만은 지키자고 했어요."
# 뺀 시장 전지가 받침에 오지 않은 채 기한 날 — 빈 손수레로 와서 '누가 먼저 가져갔대'(계획 §5.3-8)
npc N-GS-C1 8 3 N look=M1-S3-HR03-H2-T05-1-PF00-HD00-EY00 cond="UQ66_DUE > 0 and GAME_DAY == UQ66_DUE and GAME_HOUR >= 10 and GAME_HOUR < 14 and UQ66_PULLED == 1 and UQ66_GSCELL == 0 and (UQ66_BATT == 0 or UQ66_BATT == 4 or UQ66_BATT == 7) and AFF_GS > -60"
npc N-GS-C1 9 5 E look=M1-S3-HR03-H2-T05-1-PF00-HD00-EY00 cond="UQ66_DUE > 0 and GAME_DAY == UQ66_DUE - 1 and GAME_HOUR >= 8 and GAME_HOUR < 18 and UQ66_BATT == 0 and UQ66_PULLED == 0 and UQ66_GSCELL == 0 and SQH_BATT != 7 and AFF_GS > -60" bark="(손수레 바퀴에 기름을 친다) 내일 열 시. 무거운 걸 실어야 해서요."
prop price_board 1 1
text 1 1 "경매장 칠판. 위 칸 '광어 kg 38,000원'(2077), 아래 칸 분필로 '가물치 1마리 6캡'." 
prop stall_food 3 1
prop stall_food 5 1
prop fish_tub 3 3
prop fish_tub 5 3
prop fish_tub 7 4
text 7 4 "고무 함지. 흙탕물 속에서 가물치 등지느러미가 돈다. 참게 한 마리가 테두리를 기어오른다." 
prop scale 1 4
text 1 4 "저울. 눈금에 '검정필 2076'. 바늘이 0에 돌아오지 않는다 — 2킬로그램쯤 먹은 저울이다."
npc N-R01-057 6 5 N
box 10 5 stall name="생선 상자" cond="V_ACT >= 1"
prop crate_o 10 5
# FQ-JH-03 지상 배달(1-12e): 상자를 기다리는 동안(MEDIC_AT 4) 낮엔 경매장 지붕 아래 접이 들것 옆 — 밤엔 시장 뒤 터(아래 자리)
prop cot 0 5 cond="MEDIC_AT == 4"
npc C-067 1 6 N cond="MEDIC_AT == 4 and GAME_HOUR >= 6 and GAME_HOUR < 18" bark="검문소 코앞이라 오래 못 있어요. 지하시장 상자, 아직이에요?"
npc N-R02-051 3 6 W cond="MEDIC_AT == 4 and GAME_HOUR >= 6 and GAME_HOUR < 18 and SQ_S13_V_W != 2 and SQ_S13_V_W != 3" bark="반장님, 분대가 또 노량진로에 섰대요."
text 0 5 "접이 들것. 손잡이에 붉은 천 — 들것 의료반 표식. 들것 밑에 빈 약 상자 둘." cond="MEDIC_AT == 4"

# 흑석 병원 뒤뜰 벤치(1-12i UQ-66 — 퇴원 서류로 병동을 비우면 간호 7호가 '댁을 몰라서' 다섯을 여기 모신다, UQ66_WARD 1). 병원 동쪽 흙마당.
spot @989,1207 5 4
prop bench 1 1 cond="UQ66_WARD == 1"
prop bench 3 1 cond="UQ66_WARD == 1"
text 0 0 "말뚝에 집게팔 글씨 판자 — '퇴원 환자 쉼터 · 체온은 매일 아침 · 간호 7'." cond="UQ66_WARD == 1"
npc N-HS-P1 1 2 N sheet=en_cr200_loco cond="UQ66_WARD == 1" bark="(햇볕 쪽으로 고개를 든 채 움직이지 않는다)"
npc N-HS-P2 3 2 N sheet=en_cr200_loco cond="UQ66_WARD == 1" bark="(소매에 매인 '퇴원' 꼬리표를 만지작거린다)"
npc N-HS-P3 4 3 W sheet=en_cr200_loco cond="UQ66_WARD == 1" bark="(병원 쪽을 본다)"

# 보라매 활주로 공원(L-R01-17, SD-09a B · 단계 1-12i UQ-67 「보라매 마지막 비행」): 2077 '전시 항공 기념 광장' — 전투기 잔해 둘(원자력 시험기 1호 · 전시기 2호) ·
#   활주로 'SOS'(반쯤 지움) · 안내판 · 렌치 N-R01-063(고철꾼 — 침낭 · 수레 · 기한 뒤 봉천으로) · 왕개미 일개미 둘 · 길 쪽지(road_notes에서 옮김) · 맡김 상자(보관 자리 지침). 노심 그림은 UQ67_CORE · LEAK 한 값.
spot L-R01-17 14 9
prop jet_wreck 1 1 cond="UQ67_CORE == 0 and UQ67_LEAK == 0"
prop jet_wreck 1 1 state=core cond="UQ67_CORE == 0 and UQ67_LEAK == 1"
prop jet_wreck 1 1 state=sealed cond="UQ67_CORE == 1"
prop jet_wreck 1 1 state=empty cond="UQ67_CORE >= 2"
text 4 3 "시험 엔진 덮개." scene=UQ67_HATCH
text 1 2 "조종석." scene=UQ67_TAPE
prop jet_wreck 8 5 state=plain
text 9 6 "전시기 2호. 엔진 덮개가 없다 — 애초에 심장이 없던 기체. 캐노피가 열린 채다." w=2
prop info_board 7 1
text 7 1 "전시 안내판." scene=UQ67_SIGN
text 6 8 "활주로 콘크리트에 거대한 분필 'SOS'. S 하나가 반쯤 지워졌다." w=3
prop bedroll 6 4 cond="UQ67_WRENCH == 0"
prop bedroll 11 8 cond="UQ67_WRENCH == 2"
text 6 4 "엔진 덮개에 붙여 편 침낭. 베개 자리에 머리카락이 수북하다." cond="UQ67_WRENCH == 0"
text 11 8 "전시기 2호 날개 밑으로 옮긴 침낭. 베개 자리에 모자." cond="UQ67_WRENCH == 2"
text 6 5 "돌 밑 쪽지." scene=UQ67_NOTE cond="UQ67_NOTE == 0"
prop hm_cart 12 2
text 12 2 "고철 수레. 비행기 리벳 · 알루미늄 판 · 계기판 바늘. 맨 위에 쇠지레." 
prop crate_o 13 7
box 13 7 stash name="활주로 공원 맡김 상자(고철꾼이 쓰던 — 비어 있음)"
text 7 5 "굴러온 모자 하나. 안쪽에 머리카락이 엉겨 있다. 렌치 것보다 작다."
npc N-R01-063 5 4 S look=M1-S4-HR03-H3-T12-2-PF00-HD02-EY06-PR004 cond="UQ67_WRENCH == 0 and UQ67_ASK == 0" bark="따뜻하지? 밤엔 더 따뜻해."
npc N-R01-063 10 8 N look=M1-S4-HR03-H3-T12-2-PF00-HD02-EY06-PR004 cond="UQ67_WRENCH == 2" bark="(모자를 고쳐 쓴다) 안 따뜻한 쇠 밑이 이렇게 추운 줄 몰랐어."
enemy CR-080 0 7
enemy CR-080 13 0

# 봉천 아랫문 밖 비탈(1-12i UQ-67): 기한을 넘기면 렌치가 노심을 안고 봉천까지 — 다음 06:00 여기 쓰러진 채(WRENCH 3 · 노심 CORE 5) · 남무진이 살아 있으면 묻어 줌(4 — 노심은 그 옆) · HALF 뒤 ③이면 '내 반 몫은?'(렌치가 서 있음 — 활주로 공원엔 없음 ASK)
spot @891,1385 4 3
prop remains 1 1 cond="UQ67_WRENCH == 3"
text 1 1 "쓰러진 고철꾼." scene=UQ67_FALLEN cond="UQ67_WRENCH == 3 or UQ67_WRENCH == 4"
prop rubble 1 1 cond="UQ67_WRENCH == 4"
npc N-R01-063 2 1 S look=M1-S4-HR03-H3-T12-2-PF00-HD02-EY06-PR004 cond="UQ67_ASK > 0 and (UQ67_WRENCH == 0 or UQ67_WRENCH == 6) and UQ67_CORE == 3" bark="(아랫문 기둥에 기대 손바닥을 들여다본다) 반 몫…."

# 시장 뒤 터(SD-06 §12.3 고정 매복 지점 '노량진 수산시장 터' — 1-12e FQ-JH-03 밤 대기). 낮엔 빈 터, 밤엔 소윤희가 손전등을 낮춰 기다린다.
# 낮에 30분 넘게 남기고 건넸으면 박춘삼이 해 질 녘까지 강가 쪽 턱에 앉아 있다(남은 시간은 그의 몫, FQ_JH03_RIVER — 북쪽 출구 자리와 배타: PARK 2인 날).
spot @893,1151 6 4
prop tarp_pile 0 0
prop crate_army 5 0
text 0 0 "방수포 더미. 아래에 생선 상자 판자 — 누가 여기서 자고 간 자국." 
text 5 0 "빈 탄약 상자. 안쪽에 분필로 날짜 셋, 모두 밤 시각이다."
