; Engine configuration file. SD-19 §6.2~6.4 (Godot 4.7.2 고정).
config_version=5

[application]

config/name="폴아웃 : 서울"
config/use_custom_user_dir=true
config/custom_user_dir_name="Fallout Seoul"
config/description="단계 T 기술 시험판 (SD-19 §5.2)"
run/main_scene="res://scenes/title/title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

InputSetup="*res://systems/input/input_setup.gd"
ScreenFit="*res://systems/display/screen_fit.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/aspect.mobile="keep_height"
window/stretch/scale_mode="integer"

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

environment/defaults/default_clear_color=Color(0.043, 0.039, 0.051, 1)

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
textures/vram_compression/import_etc2_astc=true
