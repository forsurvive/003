    "0"
   ]
  },
  {
   "op": "line",
   "who": "N-R02-041",
   "emo": "분노",
   "text": "(낚아채 불빛을 센다) …하나 꺼졌네. 신도림에서. 네 이름 옆에 줄 하나."
  },
  {
   "op": "goto",
   "to": "PAY"
  },
  {
   "op": "cmd",
   "name": "sb02",
   "args": [
    "remote",
    "0"
   ]
  },
  {
   "op": "line",
   "who": "N-R02-041",
   "emo": "분노",
   "text": "(낚아채 불빛을 센다) …하나 꺼졌네. 줄은 이미 그어 놨어."
  },
  {
   "op": "goto",
   "to": "PAY"
  },
  {
   "op": "if",
   "cond": "FQ_SB02_SEEN == 2",
