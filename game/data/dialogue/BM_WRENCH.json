{
 "id": "BM_WRENCH",
 "title": "고철꾼 렌치",
 "loc": "L-R01-17",
 "npc": "N-R01-063",
 "cond": "V_ACT >= 1",
 "labels": {
  "START": 0,
  "AGAIN0": 8,
  "FIRST": 13,
  "AGAIN": 17,
  "LEAK_SAY": 26,
  "MOVED": 28,
  "SEALED_SAID": 33,
  "SOLO": 37,
  "HALF_PAID": 42,
  "HALF_LOST": 44,
  "HALF_WAIT": 46,
  "MENU": 48,
  "JET": 49,
  "JET_GONE": 53,
  "HAIR": 55,
  "TELL": 57,
  "TELL_T": 63,
  "TELL_N": 65,
