  "CALLED_IN": 31,
  "LINE_OK": 34,
  "SHUT": 36,
  "RECORD": 38,
  "GRADES": 45,
  "SELF": 51,
  "NOBODY": 53,
  "EMPTY_DONE": 56
 },
 "ops": [
  {
   "op": "if",
   "cond": "dead(\"N-R02-023\")",
   "to": "NOBODY"
  },
  {
   "op": "if",
   "cond": "SQ_S08_DESK >= 1",
