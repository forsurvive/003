{
 "id": "SQS08_DESK",
 "title": "둘째 창구 — 위동현",
 "loc": "L-R02-15",
 "npc": "N-R02-023",
 "cond": "V_ACT >= 1",
 "labels": {
  "START": 0,
  "STRANGER": 6,
  "MENU": 8,
