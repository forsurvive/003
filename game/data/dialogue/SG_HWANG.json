  {
   "op": "line",
   "who": "N-R01-047",
   "emo": "기본",
   "text": "제7 검문대장 황보서현 소위입니다. 이 길은 남태령을 넘어 과천 · 청계산으로 갑니다. 등록자만."
  },
  {
   "op": "do",
   "fx": "SG_MET_HWANG = 1"
  },
  {
   "op": "cmd",
   "name": "meet",
   "args": [
    "N-R01-047"
   ]
  },
  {
   "op": "if",
   "cond": "worn() == \"A-031\" and SQ_S06_CLOTH == 1 and SQ_S06_UNI == 0",
   "to": "S6UNI"
  },
  {
   "op": "if",
   "cond": "SQ_S06_SOL == 4 and SQ_S06_SALUTE == 0",
