     "fx": "",
     "to": "HIST",
     "id": "NT_EOM:4:0"
    },
    {
     "text": "대피 측실 할매를 아십니까",
     "tags": [],
     "cond": "known_dead(\"N-UG-007\") == 0 and U02_HAL == 0",
