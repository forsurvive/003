 },
 "ops": [
  {
   "op": "if",
   "cond": "dead(\"N-R02-049\") == 1",
   "to": "NOBODY"
  },
  {
   "op": "if",
   "cond": "UQ69_PAPER == 3 and GAME_DAY > KS_STAMP",
