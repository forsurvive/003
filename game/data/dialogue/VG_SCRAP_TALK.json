  {
   "op": "line",
   "who": "N-VG-S1",
   "emo": "기본",
   "text": "무게로 산 건 무게로 판다. 반값 — 그 아래는 없어."
  },
  {
   "op": "goto",
   "to": "MENU"
  },
  {
