     "id": "UQ71_BUS:1:0",
     "fail": "BURN"
    },
    {
     "text": "물속에서 정지 장치를 더듬어 찾는다",
     "tags": [
      {
       "k": "skill",
       "name": "과학",
       "min": 60
      }
     ],
     "cond": "UQ71_STAGE < 30",
     "fx": "",
     "to": "SEAL",
     "id": "UQ71_BUS:1:1",
     "fail": "BURN"
    },
    {
     "text": "강판으로 덮개 틈을 막는다",
     "tags": [
      {
       "k": "skill",
       "name": "수리",
       "min": 50
      }
     ],
     "cond": "has(\"M-013\") == 1",
