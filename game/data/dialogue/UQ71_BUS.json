     "to": "PATCH",
     "id": "UQ71_BUS:1:2",
     "fail": "BURN"
    },
    {
     "text": "노심을 재우고 받침에서 꺼낸다",
     "tags": [
      {
       "k": "skill",
       "name": "과학",
       "min": 30
      }
     ],
     "cond": "UQ71_STAGE >= 30",
     "fx": "",
     "to": "TAKE",
     "id": "UQ71_BUS:1:3",
     "fail": "BURN"
    },
    {
     "text": "노심을 받침에서 꺼낸다",
     "tags": [
      {
       "k": "skill",
       "name": "과학",
       "min": 45
      }
     ],
     "cond": "UQ71_STAGE < 30",
     "fx": "",
     "to": "TAKE",
     "id": "UQ71_BUS:1:4",
     "fail": "BURN"
