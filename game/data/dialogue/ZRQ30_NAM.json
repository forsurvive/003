{
 "id": "ZRQ30_NAM",
 "title": "옥탑 감시조장 남태하 — 밤 경계",
 "loc": "L-R01-09",
 "npc": "N-R01-028",
 "cond": "V_ACT >= 1 and MQ101_STAGE >= 100 and SQ_S02_FIGHT == 0",
 "labels": {
  "START": 0,
  "WAITGO": 10,
  "OFFER": 12,
  "START2": 14,
  "NIGHT": 15,
  "D1": 19,
  "D2": 21,
  "ONGOING": 23,
  "REPORT": 25,
  "MORNING": 28,
  "REPORT2": 30,
  "R1": 39,
  "R1_HILL": 41,
  "R2": 43,
  "R2_MANY": 45,
  "R3_UP": 47,
  "R_QUIET": 49,
  "WAIT": 51,
  "FULL": 53,
  "FULL_D": 56,
  "COLD": 58,
  "BOUNTY": 60,
  "BOUNTY_DOG": 62,
  "BOUNTY_OK": 63,
  "BOUNTY_OK2": 68,
  "BOUNTY_OK3": 70,
  "BOUNTY_LOST": 72
 },
 "ops": [
  {
   "op": "if",
   "cond": "RQ03B_ST == 2 and ((RQ03B_T == 2 and has(\"M-326\") == 1) or (RQ03B_T != 2 and has(\"M-325\") == 1))",
