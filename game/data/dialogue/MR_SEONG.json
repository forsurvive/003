     "id": "MR_SEONG:1:1"
    }
   ]
  },
  {
   "op": "line",
   "who": "N-R02-021",
   "emo": "미소",
   "text": "선반 옆에 볼트로 박는다. 오늘 밤부터 총열을 뽑아."
  },
  {
   "op": "line",
   "who": "N-R02-021",
   "emo": "기본",
   "text": "이 골목 총값 내린다. 연합 쪽 사람들한테도 말해 두지."
  },
  {
   "op": "cmd",
   "name": "ks",
   "args": [
    "give",
