     "fx": "",
     "to": "MINE",
     "id": "UQ63_BOX:3:1"
    },
    {
     "text": "그대로 다 챙긴다",
     "tags": [],
     "cond": "",
     "fx": "",
     "to": "END",
     "id": "UQ63_BOX:3:2"
    }
   ]
