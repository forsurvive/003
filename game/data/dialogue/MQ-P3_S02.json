 },
 "ops": [
  {
   "op": "line",
   "who": "C-023",
   "emo": "기본",
   "text": "왔냐. 앉아라. 재건 행정 요원 적성 평가다."
  },
  {
   "op": "if",
   "cond": "MQP3_RESULT >= 5",
