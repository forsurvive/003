  {
   "op": "cmd",
   "name": "bjs",
   "args": [
    "back",
    "0"
   ]
  },
  {
   "op": "goto",
   "to": "END"
  },
  {
   "op": "line",
   "who": "N-R01-047",
   "emo": "분노",
   "text": "적성 분자 \\V[P_FULL]. 거기서 한 걸음 더 오면 분대가 쏩니다."
  },
  {
   "op": "line",
   "who": "N-R01-047",
   "emo": "분노",
   "text": "물러서십시오. 지금이 마지막 경고입니다."
