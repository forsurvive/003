 "labels": {
  "START": 0,
  "TOP": 3,
  "MENU": 6,
  "JOB": 7,
  "J6": 10,
  "J7": 13,
  "J8": 16,
  "ONJOB": 19,
  "NOKIGUN": 21,
  "CARTHOME": 25,
  "LOSTP": 28,
  "RECOVERED": 31,
  "NOKIGUN2": 35,
  "BACKJOB": 37,
  "RETURN": 40,
  "RETURN2": 45,
  "RETURN2L": 48,
  "RETURN3": 50,
  "CLOTH": 52,
  "UNCLOTH": 55,
  "TEACH": 58,
  "WHERE": 62,
  "SEAL": 64,
  "SHOP": 66
 },
 "ops": [
  {
   "op": "if",
   "cond": "dead(\"N-UG-012\") == 1 and U04_JOB >= 6 and U04_JOB <= 8",
   "to": "NOKIGUN"
  },
  {
   "op": "if",
