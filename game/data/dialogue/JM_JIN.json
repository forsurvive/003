  "GIVE": 24,
  "RING": 27,
  "SHOP": 31
 },
 "ops": [
  {
   "op": "if",
   "cond": "SQ_S12_KNOWN == 1 and SQ_S12_J < 3",
   "to": "SOLD"
  },
  {
   "op": "if",
   "cond": "SQ_S12_J == 4",
   "to": "ROLL"
  },
  {
   "op": "if",
   "cond": "SQ_S12_J == 3",
   "to": "BOX"
  },
  {
   "op": "if",
   "cond": "JM_REG == 1",
   "to": "REG"
  },
  {
   "op": "line",
   "who": "N-R02-005",
   "emo": "기본",
   "text": "진공관 있으면 가져와. 값 쳐줄게. 마 기사가 더 쳐주긴 하지만."
  },
  {
   "op": "goto",
   "to": "MENU"
  },
  {
   "op": "line",
   "who": "N-R02-005",
   "emo": "미소",
   "text": "단골이 왔네. 둥지 치운 사람 맞지? 오늘은 내가 덜 남길게."
  },
  {
   "op": "goto",
   "to": "MENU"
  },
  {
   "op": "line",
   "who": "N-R02-005",
   "emo": "분노",
   "text": "벙커 사람들 이름을 팔았다며. 인쇄소 뒤칸에서. …물건은 팔게. 말은 안 섞어."
  },
  {
   "op": "goto",
   "to": "SHOP"
  },
  {
   "op": "line",
   "who": "N-R02-005",
   "emo": "기본",
   "text": "회의 날 잊지 마. 출석 부르듯이. 권이준."
  },
  {
   "op": "goto",
   "to": "MENU"
  },
  {
   "op": "line",
   "who": "N-R02-005",
   "emo": "기본",
   "text": "(노점 상자를 툭 친다) 그놈 이름은 여기 있어. 회의 날 내가 들고 간다."
  },
  {
   "op": "choice",
   "opts": [
    {
     "text": "물건 좀 보자",
     "tags": [],
     "cond": "",
     "fx": "",
     "to": "SHOP",
     "id": "JM_JIN:1:0"
    },
    {
     "text": "(관리 요원 신분증을 꺼낸다)",
     "tags": [],
     "cond": "has(\"M-210\") >= 1 and SQ_S12_J <= 2 and SQ_S12_SOLD == 0",
     "fx": "",
     "to": "FACE",
     "id": "JM_JIN:1:1"
    },
    {
     "text": "(쥐고 있던 반지를 내민다)",
     "tags": [],
     "cond": "has(\"M-412\") >= 1 and SQ_S12_JR == 0",
     "fx": "",
     "to": "RING",
     "id": "JM_JIN:1:2"
    },
    {
     "text": "다음에",
     "tags": [],
     "cond": "",
     "fx": "",
     "to": "END",
     "id": "JM_JIN:1:3"
    }
   ]
  },
  {
   "op": "if",
   "cond": "SQ_S12_J >= 1",
   "to": "KWON"
  },
  {
   "op": "line",
   "who": "SYS",
   "emo": "기본",
   "text": "진재석이 신분증을 한 장씩 넘긴다. 맨 앞 장에서 손가락이 멈춘다."
  },
  {
   "op": "cmd",
   "name": "s12",
   "args": [
    "show",
    "j"
   ]
  },
  {
   "op": "line",
   "who": "N-R02-005",
   "emo": "놀람",
   "text": "권이준. …사위 놈이야. 출석부에 이름을 썼구나. 그 성격에 결석은 안 했겠지."
  },
  {
   "op": "line",
   "who": "N-R02-005",
   "emo": "기본",
   "text": "1조 맨 앞이었을 거다. 아홉 시 넘어 셔터 열자마자 나갔으니까. 늦는 꼴을 못 봤어, 그놈."
  },
  {
   "op": "line",
   "who": "N-R02-005",
   "emo": "기본",
   "text": "이거 회의 같은 데 가져갈 거면 — 거기서 그놈 이름 불러. 출석 부르듯이."
  },
  {
   "op": "choice",
   "opts": [
    {
     "text": "회의 탁자에 올리겠습니다. 이름을 부르게",
     "tags": [],
     "cond": "",
     "fx": "",
     "to": "KEEP",
     "id": "JM_JIN:2:0"
    },
    {
     "text": "이건 장인어른이 가지셔야죠",
     "tags": [],
     "cond": "",
     "fx": "",
     "to": "GIVE",
     "id": "JM_JIN:2:1"
    },
    {
     "text": "생각해 보겠습니다",
     "tags": [],
     "cond": "",
     "fx": "",
     "to": "MENU",
     "id": "JM_JIN:2:2"
    }
   ]
  },
  {
   "op": "cmd",
   "name": "s12",
   "args": [
    "keep",
    "j"
   ]
  },
  {
   "op": "line",
   "who": "N-R02-005",
   "emo": "미소",
   "text": "그래. 그놈은 대답 못 해도, 누가 대신 '출석' 하겠지."
  },
  {
   "op": "goto",
   "to": "MENU"
  },
  {
   "op": "cmd",
   "name": "s12",
   "args": [
    "give",
    "j"
   ]
  },
  {
   "op": "line",
   "who": "N-R02-005",
   "emo": "기본",
   "text": "…이걸 왜 나한테 줘. (한참 들여다보다 노점 상자에 넣는다) 회의 날 되면 내가 들고 가지."
  },
  {
   "op": "goto",
   "to": "MENU"
  },
  {
   "op": "cmd",
   "name": "s12",
   "args": [
    "item",
    "j"
   ]
  },
  {
   "op": "line",
   "who": "N-R02-005",
   "emo": "슬픔",
   "text": "반지네. 근무 중엔 빼야 한다고, 그 규정쟁이가. …빼서 쥐고 있었구나."
  },
  {
   "op": "line",
   "who": "N-R02-005",
   "emo": "기본",
   "text": "규정은 지키고, 반지는 놓지 않았구나. 고지식한 놈인 줄만 알았지."
  },
  {
   "op": "goto",
   "to": "MENU"
  },
  {
   "op": "cmd",
   "name": "trade",
   "args": [
    "VJ05"
   ]
  },
  {
   "op": "goto",
   "to": "END"
  },
  {
   "op": "end"
  }
 ],
