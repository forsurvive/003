   ]
  },
  {
   "op": "line",
   "who": "C-051",
   "emo": "피곤",
   "text": "다 꿰맸어. 오늘은 둥지 근처에도 가지 마."
  },
  {
   "op": "goto",
   "to": "END"
  },
  {
