{
 "id": "UQ02_GIVE",
 "title": "개집 앞 — 새끼를 내려놓는다",
 "loc": "L-R01-09",
 "npc": "N-R01-029",
 "cond": "UQ02_CARRY == 1",
 "labels": {
  "START": 0,
  "DOGAWAY": 4,
  "NODOG": 6,
