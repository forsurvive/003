  {
   "op": "goto",
   "to": "TRADE"
  },
  {
   "op": "if",
   "cond": "SQ_S06_MET >= 1 and SQ_S06_PAPERS == 0 and SQ_S06_JIN <= 1 and SQ_S06_ROUTE < 2",
