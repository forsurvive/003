  "MENU": 14,
  "BACK": 17,
  "MENU2": 19,
  "SHOE": 20,
  "PUT": 24,
  "SCOPE": 28,
  "SCOPE_WARM": 35,
  "SCOPE_HEAT": 37,
  "SCOPE_DONE": 39,
  "CAR": 41,
  "CAR_KNOWN": 46,
  "NORTH": 48,
  "ROPE": 50,
  "BYE": 52,
  "HIDE": 55,
  "HIDE_CALLED": 60,
  "HIDE_FIRST": 61,
  "HIDE_AGAIN": 68
 },
 "ops": [
  {
   "op": "if",
   "cond": "KT_HEAT == 1 and KT_QUEEN == 0",
   "to": "HIDE"
  },
  {
   "op": "if",
   "cond": "KT_MEET >= 1",
