  "S5TIP2": 20,
  "GUIDE": 24,
  "TUNNEL": 28,
  "S5WEST": 32,
  "S5GUIDE": 34
 },
 "ops": [
  {
   "op": "if",
   "cond": "SD_MET_BAN >= 1",
   "to": "AGAIN"
  },
  {
   "op": "line",
   "who": "N-R01-045",
   "emo": "미소",
   "text": "검문소 밑으로 가는 길? 10캡이면 남태령까지 데려다줄게."
  },
  {
   "op": "line",
   "who": "N-R01-045",
   "emo": "기본",
   "text": "반로아. 남태령 꼬마라고들 해. 꼬마 아니야, 열두 살이야."
  },
  {
   "op": "do",
   "fx": "SD_MET_BAN = 1"
  },
  {
   "op": "cmd",
   "name": "meet",
   "args": [
    "N-R01-045"
   ]
  },
  {
   "op": "goto",
   "to": "ASK"
  },
  {
   "op": "line",
   "who": "N-R01-045",
   "emo": "기본",
   "text": "또 왔어? 오늘은 뭐 물어볼 건데. 물어보는 것도 돈 받을까 생각 중이야."
  },
  {
   "op": "choice",
   "opts": [
    {
     "text": "남태령까지 안내해 줘",
     "tags": [],
     "cond": "",
     "fx": "",
     "to": "GUIDE",
     "id": "SD_BAN:1:0"
    },
    {
     "text": "터널은 어때?",
     "tags": [],
     "cond": "",
     "fx": "",
     "to": "TUNNEL",
     "id": "SD_BAN:1:1"
    },
    {
     "text": "노들섬까지 검문 안 거치고 가는 길 알아?",
     "tags": [],
     "cond": "SQ_S06_MET >= 1 and SQ_S06_JIN <= 1 and SQ_S06_ROUTE < 2",
     "fx": "",
     "to": "S6ASK",
     "id": "SD_BAN:1:2"
    },
    {
     "text": "정기권 말인데 — 그거 말고 다른 비밀은 없어?",
     "tags": [],
     "cond": "SQS05_STAGE >= 10 and SQ_S05_TIP == 0 and SQ_S05_PASS == 0",
     "fx": "",
     "to": "S5TIP",
     "id": "SD_BAN:1:3"
    },
    {
     "text": "됐어",
     "tags": [],
     "cond": "",
     "fx": "",
     "to": "END",
     "id": "SD_BAN:1:4"
    }
   ]
  },
  {
   "op": "line",
   "who": "N-R01-045",
   "emo": "기본",
   "text": "노들섬? 땅으로는 다리목을 꼭 지나. 땅 밑으로도 강은 못 건너고. 길은 셋이야 — 짐, 물, 종이."
  },
  {
   "op": "line",
   "who": "N-R01-045",
   "emo": "미소",
   "text": "짐은 고개길 수송대 아줌마, 물은 수산시장 심 아저씨가 밤에, 종이는 지하시장 인쇄소. 누구 데려가는지는 안 물어볼게. 이건 공짜야."
  },
  {
   "op": "if",
   "cond": "known_dead(\"N-R01-040\") == 1",
   "to": "S6NOYEON"
  },
  {
   "op": "if",
   "cond": "known_dead(\"N-R02-008\") == 1",
   "to": "S6NOYEOM"
  },
  {
   "op": "goto",
   "to": "S6ASKED"
  },
  {
   "op": "line",
   "who": "N-R01-045",
   "emo": "슬픔",
   "text": "…아, 수송대 아줌마는 이제 없지. 짐 길은 지웠어."
  },
  {
   "op": "goto",
   "to": "S6ASKED"
  },
  {
   "op": "line",
   "who": "N-R01-045",
   "emo": "슬픔",
   "text": "인쇄소 아줌마 소식 들었어? 염희정 없으면 종이도 없어."
  },
  {
   "op": "cmd",
   "name": "s06",
   "args": [
    "asked"
   ]
  },
  {
   "op": "goto",
   "to": "ASK"
  },
  {
   "op": "line",
   "who": "N-R01-045",
   "emo": "기본",
   "text": "정기권? 서랍에 있는 건 다 알아. 비밀은 그게 아니고."
  },
  {
   "op": "choice",
   "opts": [
    {
     "text": "그럼 비밀은 뭔데?",
     "tags": [
      {
       "k": "caps",
       "n": 10
      }
     ],
     "cond": "PC_CAPS >= 10",
     "fx": "",
     "to": "S5TIP2",
     "id": "SD_BAN:2:0"
    },
    {
     "text": "됐어",
     "tags": [],
     "cond": "",
     "fx": "",
     "to": "ASK",
     "id": "SD_BAN:2:1"
    }
   ]
  },
  {
   "op": "do",
   "fx": "caps(-10); SQ_S05_TIP = 1"
  },
  {
   "op": "line",
   "who": "N-R01-045",
   "emo": "미소",
   "text": "역장님은 아침 여섯 시랑 저녁 여섯 시에 벽시계 태엽을 감아. 십 분쯤. 그동안은 등이 문 쪽이야."
  },
  {
   "op": "line",
   "who": "N-R01-045",
   "emo": "기본",
   "text": "난 아무 말도 안 했어. 10캡 받은 것도 없고."
  },
  {
   "op": "goto",
   "to": "ASK"
  },
  {
   "op": "if",
   "cond": "U02_OPEN >= 1",
   "to": "END"
  },
  {
   "op": "line",
   "who": "N-R01-045",
   "emo": "기본",
   "text": "오늘은 안 돼. 남쪽 터널에 쥐 떼가 올라왔어. 굴쥐는 무리 지으면 사람도 물어."
  },
  {
   "op": "line",
   "who": "N-R01-045",
   "emo": "기본",
   "text": "쥐 떼 내려가면 다시 와. 그때도 10캡이야. 깎아 달라고 하면 15캡."
  },
  {
   "op": "goto",
   "to": "ASK"
  },
  {
   "op": "line",
   "who": "N-R01-045",
   "emo": "기본",
   "text": "4호선 남쪽은 내 길이야. 시궁쥐, 굴쥐, 물 고인 데, 무너진 데 다 알아. 남태령 역까지 한 시간."
  },
  {
   "op": "if",
   "cond": "SQ_S05_SOL >= 1 and SQ_S05_SOL <= 3",
   "to": "S5WEST"
  },
  {
   "op": "line",
   "who": "N-R01-045",
   "emo": "기본",
   "text": "서쪽은 안 가. 거긴 손님 자리래. 어른들이 그래."
  },
  {
   "op": "goto",
   "to": "ASK"
  },
  {
   "op": "line",
   "who": "N-R01-045",
   "emo": "미소",
   "text": "서쪽 안내도 해. 사당에서 서울대입구까지 지하로. 봉천 사다리 앞에 내려 줄게. 10캡."
  },
  {
   "op": "choice",
   "opts": [
    {
     "text": "데려다줘",
     "tags": [
      {
       "k": "caps",
       "n": 10
      }
     ],
     "cond": "PC_CAPS >= 10",
     "fx": "",
     "to": "S5GUIDE",
     "id": "SD_BAN:3:0"
    },
    {
     "text": "나중에",
     "tags": [],
     "cond": "",
     "fx": "",
     "to": "ASK",
     "id": "SD_BAN:3:1"
    }
   ]
  },
  {
   "op": "do",
   "fx": "caps(-10)"
  },
  {
   "op": "line",
   "who": "N-R01-045",
   "emo": "기본",
   "text": "따라와. 레일 가운데로 걸어. 낙성대에선 말 걸지 말고."
  },
  {
   "op": "cmd",
   "name": "s05",
   "args": [
    "guide"
   ]
  },
  {
   "op": "goto",
   "to": "END"
  },
  {
   "op": "end"
  }
 ],
