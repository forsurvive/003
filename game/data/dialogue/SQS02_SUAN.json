  },
  {
   "op": "if",
   "cond": "SQ_S02_LEVEL == 0",
   "to": "DRY"
  },
  {
   "op": "if",
   "cond": "FQ_JC01_CAP < 5",
   "to": "JCBOTH"
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "피곤",
   "text": "왔어? 수위계 봤지. 오늘도 한 칸."
  },
  {
   "op": "goto",
   "to": "ASK"
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "피곤",
   "text": "윗물은 패거리가 잠갔고, 아랫물은 끊겼어. 수위계가 양쪽에서 깎여."
  },
  {
   "op": "goto",
   "to": "ASK"
  },
  {
   "op": "if",
   "cond": "FQ_JC01_FLOW == 0",
   "to": "JCCUT"
  },
  {
   "op": "if",
   "cond": "FQ_JC01_CRACK == 0",
   "to": "JCLEAK"
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "기본",
   "text": "넷에서 서. 나머지 한 칸은 고시원 몫이래. …뭐, 우리도 빗물 얻어 쓰는 처지니까."
  },
  {
   "op": "goto",
   "to": "S03ASK"
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "피곤",
   "text": "윗관은 물소리가 나는데 수위계가 셋에서 안 올라. 계곡 수로가 끊긴 거야. 수로는 마을 거니까 이장님한테 가 봐."
  },
  {
   "op": "goto",
   "to": "S03ASK"
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "기본",
   "text": "수로 물은 돌아왔는데 유입구 이음매가 새. 수위계가 한 칸 모자라게 떨기만 해. 칠판에 '샌다' 적어 놨어."
  },
  {
   "op": "goto",
   "to": "S03ASK"
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "기본",
   "text": "물이 내려와. 누가 패거리한테 물값을 냈대. …사흘이야. 나흘째엔 또 잠겨."
  },
  {
   "op": "goto",
   "to": "ASK"
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "슬픔",
   "text": "붉은 띠 아래야. 아이들 몫부터 떼고 나면 남는 게 없어. 장터 물값이 두 배가 됐어."
  },
  {
   "op": "goto",
   "to": "ASK"
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "미소",
   "text": "관에서 물 내려오는 소리, 밤에 들으면 잠이 와. 수위계도 다섯 칸 그대로야."
  },
  {
   "op": "goto",
   "to": "S03ASK"
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "기본",
   "text": "배수지 물은 한 집 하루 두 통. 끓여 마셔. 그게 규칙이야."
  },
  {
   "op": "goto",
   "to": "S03ASK"
  },
  {
   "op": "do",
   "fx": "SQ_S02_HEARD = 1"
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "슬픔",
   "text": "상류 밸브가 또 잠겼어. 패거리 짓이야. 끓여 마셔도 없는 물은 안 생겨."
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "기본",
   "text": "관악산 약수 계통에서 내려오는 관이 하나 있는데, 그 중간 밸브를 남부순환 패거리가 틀어쥐었어. 물값을 내래. 하루 30캡."
  },
  {
   "op": "if",
   "cond": "SQS02_STAGE >= 10",
   "to": "ASK"
  },
  {
   "op": "do",
   "fx": "quest(\"SQ-S02\", 10)"
  },
  {
   "op": "choice",
   "opts": [
    {
     "text": "상류 밸브는 어디 있어?",
     "tags": [],
     "cond": "SQS02_STAGE >= 10 and SQS02_STAGE < 70",
     "fx": "",
     "to": "WHERE",
     "id": "SQS02_SUAN:1:0"
    },
    {
     "text": "싸우지 않고 물을 돌릴 길은?",
     "tags": [],
     "cond": "SQS02_STAGE >= 20 and SQS02_STAGE < 70 and SQ_S02_PIPEMAP == 0",
     "fx": "",
     "to": "BYPASS",
     "id": "SQS02_SUAN:1:1"
    },
    {
     "text": "이음 지점이 어디랬지?",
     "tags": [],
     "cond": "SQ_S02_PIPEMAP == 1 and SQ_S02_SOL == 0",
     "fx": "",
     "to": "BYPASS2",
     "id": "SQS02_SUAN:1:2"
    },
    {
     "text": "저수조 벽의 검은 얼룩 말이야",
     "tags": [],
     "cond": "SQS03_STAGE >= 10 and SQS03_STAGE < 70 and SQ_S03_SAID == 0",
     "fx": "",
     "to": "S03_WALL",
     "id": "SQS02_SUAN:1:3"
    },
    {
     "text": "꼭지에 필터라도 달면?",
     "tags": [],
     "cond": "SQS03_STAGE >= 10 and SQS03_STAGE < 70 and SQ_S03_FILTER == 0",
     "fx": "",
     "to": "S03_D",
     "id": "SQS02_SUAN:1:4"
    },
    {
     "text": "됐어",
     "tags": [],
     "cond": "",
     "fx": "",
     "to": "END",
     "id": "SQS02_SUAN:1:5"
    }
   ]
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "기본",
   "text": "밸브실 벽에 관로 계통도가 있어. 봐. 산 쪽 붉은 × — 삼성산 능선 아래야. 패거리가 거기 진을 쳤어."
  },
  {
   "op": "goto",
   "to": "ASK"
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "기본",
   "text": "…계곡 쪽에 옛 관로가 있어. 2077년 전에 쓰던 거. 관악 계곡 배수로를 지나서 내려와."
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "기본",
   "text": "이음 지점 두 군데가 끊겼어. 고철 넷, 공업용 테이프 둘, 그리고 손 좋은 사람. 지도는 빌려줄게."
  },
  {
   "op": "do",
   "fx": "SQ_S02_PIPEMAP = 1"
  },
  {
   "op": "line",
   "who": "SYS",
   "emo": "기본",
   "text": "조수안이 기름종이에 옛 관로를 베껴 준다. 계곡 배수로 안 두 곳에 동그라미."
  },
  {
   "op": "goto",
   "to": "ASK"
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "기본",
   "text": "관악 계곡 배수로 안, 동그라미 두 곳. 고철 넷, 테이프 둘. [수리]를 좀 할 줄 알아야 해."
  },
  {
   "op": "goto",
   "to": "ASK"
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "놀람",
   "text": "들려? 관에서 물 내려오는 소리. …수위계가 올라가고 있어."
  },
  {
   "op": "if",
   "cond": "SQ_S02_SOL == 4",
   "to": "THANKS_BJ"
  },
  {
   "op": "if",
   "cond": "SQ_S02_B == 1",
   "to": "THANKS_B"
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "미소",
   "text": "고마워. 이건 우리 몫이야. 약수 다섯 병, 그리고 반상회에서 걷은 캡."
  },
  {
   "op": "goto",
   "to": "PAY"
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "미소",
   "text": "옛 관로라니. 이제 산 위 밸브는 아무것도 아니야. 정수한 물은 앞으로 네게 싸게 줄게."
  },
  {
   "op": "if",
   "cond": "SQ_S03_CLEAN == 1 or SQ_S03_WALL == 1",
   "to": "PAY"
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "피곤",
   "text": "근데 — 관 물에서 냄새가 나. 끓여도 안 빠져. 저수조 이음 벽 봤어? 검은 게 피었어."
  },
  {
   "op": "goto",
   "to": "PAY"
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "기본",
   "text": "계엄군이 밸브를 쳤다며. 밸브실에 '관리 계엄사령부' 표지가 붙었대. …물은 물이지. 고마워."
  },
  {
   "op": "do",
   "fx": "give(\"I-056\", 5); caps(100); SQ_S02_REWARD = 1"
  },
  {
   "op": "goto",
   "to": "END"
  },
  {
   "op": "choice",
   "opts": [
    {
     "text": "저수조 벽의 검은 얼룩 말이야",
     "tags": [],
     "cond": "SQS03_STAGE >= 10 and SQS03_STAGE < 70 and SQ_S03_SAID == 0",
     "fx": "",
     "to": "S03_WALL",
     "id": "SQS02_SUAN:2:0"
    },
    {
     "text": "꼭지에 필터라도 달면?",
     "tags": [],
     "cond": "SQS03_STAGE >= 10 and SQS03_STAGE < 70 and SQ_S03_FILTER == 0",
     "fx": "",
     "to": "S03_D",
     "id": "SQS02_SUAN:2:1"
    },
    {
     "text": "됐어",
     "tags": [],
     "cond": "",
     "fx": "",
     "to": "END",
     "id": "SQS02_SUAN:2:2"
    }
   ]
  },
  {
   "op": "do",
   "fx": "SQ_S03_SAID = 1"
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "피곤",
   "text": "봤구나. 끓여도 냄새는 안 빠져. 위쪽은 몰라. 관은 산에서 와."
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "기본",
   "text": "밸브실 계통도에 끊긴 점선이 하나 있어. 옛 관로. 거기 입구 거름망이 요새 시커매."
  },
  {
   "op": "goto",
   "to": "END"
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "기본",
   "text": "필터? 꼭지 앞에 틀 하나 짜서 숯이랑 모래를 채우면 돼. 강판 한 장이랑 손 좋은 사람."
  },
  {
   "op": "choice",
   "opts": [
    {
     "text": "강판으로 필터 틀을 짜서 꼭지에 단다",
     "tags": [
      {
       "k": "skill",
       "name": "수리",
       "min": 25
      }
     ],
     "cond": "has(\"M-013\") == 1",
     "fx": "",
     "to": "S03_D_OK",
     "id": "SQS02_SUAN:3:0",
     "fail": "S03_D_NO"
    },
    {
     "text": "나중에",
     "tags": [],
     "cond": "",
     "fx": "",
     "to": "END",
     "id": "SQS02_SUAN:3:1"
    }
   ]
  },
  {
   "op": "do",
   "fx": "take(\"M-013\", 1)"
  },
  {
   "op": "cmd",
   "name": "s03",
   "args": [
    "filter"
   ]
  },
  {
   "op": "line",
   "who": "SYS",
   "emo": "기본",
   "text": "강판을 접어 틀을 짜고 숯과 모래를 켜켜이 채운다. 꼭지 물이 틀을 지나 맑게 떨어진다."
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "기본",
   "text": "위쪽 일은 위쪽 사람들 일이지. 우리 물은 우리가 거른다. …얼마나 버틸지는 칠판에 적어 둘게."
  },
  {
   "op": "goto",
   "to": "END"
  },
  {
   "op": "line",
   "who": "SYS",
   "emo": "기본",
   "text": "틀이 맞지 않는다. 이음매에서 물이 샌다. 강판은 다시 쓸 수 있다."
  },
  {
   "op": "goto",
   "to": "END"
  },
  {
   "op": "if",
   "cond": "SQ_S03_SOL == 1",
   "to": "S03_DA"
  },
  {
   "op": "if",
   "cond": "SQ_S03_SOL == 2",
   "to": "S03_DB"
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "놀람",
   "text": "볼트가 물길을 돌렸다고? …그 산 위 사람들이 우리 말을 들었다는 거네."
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "기본",
   "text": "2주면 마른대. 꼭지 냄새도 날마다 조금씩 빠지겠지. 기다리는 건 잘해, 우리."
  },
  {
   "op": "goto",
   "to": "S03_PAY"
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "놀람",
   "text": "불을 질렀다고? …물은 맑아졌어. 너구리들이 내려온대, 따뜻한 데를 잃었다고. 밤엔 조심해."
  },
  {
   "op": "goto",
   "to": "S03_PAY"
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "미소",
   "text": "약품 냄새도 안 나. 배합을 맞췄구나. 하류 사람들이 이 물을 마셔."
  },
  {
   "op": "cmd",
   "name": "s03",
   "args": [
    "report"
   ]
  },
  {
   "op": "if",
   "cond": "SQ_S03_FILTER == 1",
   "to": "S03_PAYF"
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "기본",
   "text": "반상회 몫이야. 그리고 이거 — 꼭지 필터. 이제 배수지 물은 안 끓여도 돼."
  },
  {
   "op": "goto",
   "to": "END"
  },
  {
   "op": "line",
   "who": "N-R01-032",
   "emo": "기본",
   "text": "반상회 몫이야. 네가 단 필터는 내가 갈아 끼울게. 이제 정말 안 끓여도 돼."
  },
  {
   "op": "goto",
   "to": "END"
  },
  {
   "op": "end"
  }
 ],
 "src": "script/act1/SQ-S02.txt"
}