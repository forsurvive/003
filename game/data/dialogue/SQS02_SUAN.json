   "cond": "SQ_S02_POSTED == 0",
   "to": "PLAIN"
  },
  {
   "op": "if",
   "cond": "SQS02_STAGE >= 70 and FQ_JC01_CAP < 5",
   "to": "JCRAIN"
  },
  {
   "op": "if",
   "cond": "SQS02_STAGE >= 70",
   "to": "AFTER"
  },
  {
   "op": "if",
   "cond": "SQ_S02_HEARD == 0",
   "to": "TELL"
  },
  {
   "op": "if",
