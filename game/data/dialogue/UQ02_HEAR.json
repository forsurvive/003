     "id": "UQ02_HEAR:1:1"
    }
   ]
  },
  {
   "op": "line",
   "who": "N-R01-034",
   "emo": "슬픔",
   "text": "…말하면 어른들이 쫓아낸대. 아기 개야. 엄마가 없어."
  },
  {
   "op": "line",
   "who": "N-R01-034",
   "emo": "기본",
   "text": "밤에 백구가 밥 물고 아랫문 나가. 길 건너 개천 있는 데, 큰 구멍 뒤. 거기 있어. 털이 갈색이고 귀 끝만 하얘."
  },
  {
   "op": "line",
   "who": "N-R01-034",
   "emo": "분노",
   "text": "쫓아내면 안 돼. 약속해."
  },
  {
   "op": "do",
   "fx": "UQ02_HOW = 2; UQ02_SOLNA_TOLD = GAME_DAY; quest(\"UQ-02\", 20)"
