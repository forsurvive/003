     "fx": "",
     "to": "BADGE",
     "id": "V24_DESK:2:1"
    },
    {
     "text": "점포 번호 0417, 점주명 '24시'",
     "tags": [],
     "cond": "UQ01_LR13 == 1",
     "fx": "",
     "to": "LEDGER",
     "id": "V24_DESK:2:2"
    },
    {
     "text": "다음에 할게요",
     "tags": [],
     "cond": "",
     "fx": "",
     "to": "MENU",
     "id": "V24_DESK:2:3"
    }
   ]
