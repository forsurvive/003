  },
  {
   "op": "line",
   "who": "N-R02-039",
   "emo": "미소",
   "text": "채윤재입니다. 번호 말고 이름으로 불리니까… 그게 제일 좋네요."
  },
  {
   "op": "goto",
   "to": "END"
  },
  {
   "op": "cmd",
   "name": "s09",
   "args": [
    "reunion"
   ]
  },
  {
   "op": "goto",
   "to": "END"
  },
  {
   "op": "if",
   "cond": "SB_127 == 6",
