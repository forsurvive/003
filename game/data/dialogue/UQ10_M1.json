{
 "id": "UQ10_M1",
 "title": "국밥 장수",
 "loc": "L-R02-12",
 "npc": "N-YM-1",
 "cond": "V_ACT >= 1",
 "labels": {
  "START": 0,
  "LIGHTER": 8,
  "GENEROUS": 10,
  "HONEST": 12,
