ts":[{"x":5,"y":9,"w":1,"h":1,"text":"녹슨 배관 사다리. 옥상까지 이어진다. 가로대가 몇 칸 빠졌다."},{"x":4,"y":7,"w":4,"h":1,"text":"옛 공구상가 B동. 1층 셔터는 모두 용접돼 있다. 문이 없다."},{"x":10,"y":4,"w":1,"h":2,"text":"판자 다리. 두 장을 철사로 묶었다. 본동 옥상까지 한 걸음."},{"x":31,"y":3,"w":2,"h":2,"text":"옥상 망루. 마당과 정문, 뒷골목까지 한눈에 든다."},{"x":27,"y":6,"w":1,"h":1,"text":"옥상 뚜껑. 아래는 본동 2층 복도다.","scene":"X-SB_HATCH"},{"x":25,"y":33,"w":2,"h":1,"text":"칠판 '오늘의 인력 단가'.","scene":"X-SB_BOARD"},{"x":19,"y":34,"w":1,"h":1,"text":"번호표 초소. 창구로 번호표를 내준다. 오늘 번호는 '7'부터.","scene":"X-SB_BOOTH"},{"x":14,"y":14,"w":3,"h":2,"text":"경매대. 팔레트를 쌓은 단 위 철판 연단에 번호 원판. 손종이 걸려 있다."},{"x":13,"y":22,"w":2,"h":4,"text":"번호표 줄. 쇠파이프 난간을 따라 바닥이 반들반들하다. 새벽마다 수백 켤레가 섰다."},{"x":29,"y":17,"w":1,"h":1,"text":"드럼통 화로. 장작 대신 젖은 장부 종이가 탄다.","scene":"X-SB_FIRE"},{"x":30,"y":27,"w":3,"h":2,"text":"인솔조 트럭. 짐칸에 쇠고리가 줄지어 박혀 있다. 사람을 묶는 고리다."},{"x":11,"y":32,"w":2,"h":2,"text":"마당 망루. 사다리 밑에 빈 탄통이 굴러다닌다."},{"x":18,"y":10,"w":1,"h":1,"text":"본동 정면 게시판. '근태 목걸이를 풀려는 자 — 목걸이가 먼저 안다.'"},{"x":37,"y":24,"w":1,"h":1,"text":"창고동 셔터. 반쯤 올라가 있다. 안쪽이 '인력' 우리다."},{"x":42,"y":26,"w":2,"h":1,"text":"경비견 우리. 철망 문이 열려 있다. 밥통이 비었다."},{"x":45,"y":26,"w":2,"h":1,"text":"경비견 우리. 사슬 끝이 끊겨 있다."},{"x":47,"y":33,"w":1,"h":1,"text":"짐소 우리였던 자리. 여물통에 마른 짚만 남았다. 짐소는 고척 현장으로 나갔다."},{"x":45,"y":37,"w":2,"h":1,"text":"뒷문. 철판 문짝이 떨어져 나갔다. 안에서 개 냄새와 짚 냄새."}],"signs":[],"triggers":[{"x":21,"y":37,"w":3,"h":1,"scene":"X-SB_GATE","cond":"SB_PASS == 0 and SB_RAID == 0 and V_ACT >= 1","once":false},{"x":45,"y":38,"w":2,"h":1,"scene":"X-SB_BACK","cond":"SB_DOGS == 0 and SB_RAID == 0","once":false}],"enemies":[{"id":"CR-107","x":42,"y":29,"cond":"SB_DOGS == 0","dir":"S","stance":"hold"},{"id":"CR-107","x":45,"y":30,"cond":"SB_DOGS == 0","route":[[44,29,4.0],[46,33,4.0]]},{"id":"CR-107","x":43,"y":33,"cond":"SB_DOGS == 0","dir":"E","stance":"hold"},{"id":"CR-107","x":46,"y":28,"cond":"SB_DOGS == 0","dir":"W","stance":"hold"}],"boxes":[],"terms":[],"structs":[{"kind":"roof","x":3,"y":3,"w":7,"h":4,"seed":1,