:480},{"name":"antenna","x":46,"y":14,"px":[1471,415],"sort_y":480}],"doors":[],"exits":[{"x":7,"y":7,"to":"K-40","mark":"from_W"},{"x":20,"y":7,"to":"K-44","mark":"from_W"},{"x":40,"y":7,"to":"K-43","mark":"from_W"},{"x":40,"y":1,"to":"K-43","mark":"from_back"},{"x":6,"y":18,"to":"K-42","mark":"from_W"},{"x":34,"y":14,"to":"K-41","mark":"from_roof"}],"marks":{"arrive":[47,21,"W"],"gate_e":[46,21,"W"],"gate_s":[21,34,"N"],"yard":[22,22,"S"],"yard2":[20,10,"S"],"front":[30,34,"N"],"west":[6,23,"S"],"back":[40,1,"S"],"d_door":[40,8,"S"],"b_roof":[34,14,"S"],"walk1":[44,8,"S"],"walk2":[47,21,"E"],"from_K-40":[7,8,"S"],"from_K-40b":[7,1,"S"],"from_K-44":[20,8,"S"],"from_K-43":[40,8,"S"],"from_K-43b":[41,1,"E"],"from_K-42":[6,19,"S"],"from_K-41":[34,15,"S"]},"npcs":[{"id":"N-GC-G1","x":46,"y":21,"dir":"W","route":[],"cond":"GC_HOT == 0 and GC_BOSS != 2 and (GAME_HOUR >= 6 and GAME_HOUR < 23) and dead(\"N-GC-G1\") == 0","bark":"분양 받으러 왔어? 상담료 50.","look":"M1-S4-HR02-H6-T04-2-PF04-HD06-EY00","sheet":"st_look_m1_s4_hr02_h6_t04_2_pf04_hd06_ey00"},{"id":"N-GC-G2","x":21,"y":35,"dir":"S","route":[],"cond":"GC_HOT == 0 and GC_BOSS != 2 and (GAME_HOUR >= 6 and GAME_HOUR < 23) and dead(\"N-GC-G2\") == 0","bark":"분양 끝. 상담은 동쪽 초소.","look":"M2-S4-HR01-H4-T04-2-PF00-HD08-EY00","sheet":"st_look_m2_s4_hr01_h4_t04_2_pf00_hd08_ey00"}],"texts":[{"x":45,"y":19,"w":1,"h":1,"text":"초소. 2077년 경비 초소에 패거리가 판자를 덧댔다. 안에 '분양 상담 — 상담료 50'. 글씨 밑에 총알 자국."},{"x":18,"y":33,"w":1,"h":1,"text":"남쪽 초소. 판자에 '분양 끝 — 돌아가'. 그 밑에 작게 '상담은 동쪽'."},{"x":18,"y":30,"w":1,"h":1,"text":"셔터 내린 문구점. 셔터에 분필 '패거리 창고 — 열면 손목'. 안쪽에서 깡통 구르는 소리."},{"x":30,"y":30,"w":1,"h":1,"text":"컵밥집 문. 자물쇠 셋. 유리 너머 라면 상자 탑 — 2077년 것과 2277년 것이 섞여 있다."},{"x":41,"y":30,"w":1,"h":1,"text":"셔터. 분양 광고지가 200년 겹쳐 붙었다. 맨 위 종이는 새것 — '남부순환 분양 사무실 ↑ B동 옥상'."},{"x":7,"y":8,"w":1,"h":1,"text":"A동 현관. 문마다 달력 — 모두 2077년 11월에 멈췄다. 15일에 동그라미."},{"x":20,"y":8,"w":1,"h":1,"text":"7동 현관. 문패 '삼성 고시원'. 옆에 분필 근무표 — '물당번 03~06 · 7-201 7-305 7-108'."},{"x":40,"y":8,"w":1,"h":1,"text":"D동 현관. 3층 창 하나만 밤에도 켜져 있다. 문 앞에 술병 · 담배 — 누가 두고 간 공물.","cond":"UQ62_TUBE == 0 and UQ62_DONE == 0"},{"x":40,"y":8,"w":1,"h":1,"text":"D동 현관. 3층 창이 어둡다 — 200년 켜져 있던 불. 문 앞 공물은 그대로다, 아직은.","cond":"UQ62_TUBE == 1 or UQ62_DONE >= 1"},{"x":6,"y":19,"w":1,"h":1,"text":"C동 입구. 지하 독서실 계단. 벽에 패거리가 새긴 '여기가 우리 동네'. 그 아래 2077년 글씨 '조용히'."},{"x":34,"y":15,"w":1,"h":1,"text":"B동 옥상 문. 2077년 분양 현수막이 문 위에 걸려 있다 — '남부순환 분양 사무실'. 바람에 '분양'만 펄럭인다."},{"x":40,"y":14,"w":1,"h":1,"text":"판자 다리. 옥상과 물탱크 옥탑을 잇는다. 판자 세 장이 빠졌다 — 뛰면 된다."},{"x":44,"y":14,"w":1,"h":1,"text":"물탱크 옥탑. 탱크는 비었다. 밑에 누가 자고 간 담요 · 망원경 자국."},{"x":2,"y":1,"w":1,"h":1,"text":"뒷골목. 담벼락에 분필 화살표 '부적 방 ↑'. 바닥에 술병 하나 — 공물을 두러 다니는 길."},{"x":20,"y":1,"w":1,"h":1,"text":"뒷골목. 꽁초가 한 줄로 떨어져 있다 — 누가 걸으며 피웠다. 화살표는 동쪽을 가리킨다."},{"x":36,"y":1,"w":3,"h":1,"text":"뒷골목 끝. D동 뒷계단 철문. 패거리가 공물을 두러 오르는 길 — '부적 방 3층'. 문은 잠기지 않았다."},{"x":22,"y":22,"w":1,"h":1,"text":"드럼통 불. 패거리가 둘러앉는 자리. 재 속에 2077년 수험서 — 불쏘시개."},{"x":21,"y":10,"w":1,"h":1,"text":"윗마당 드럼통. 밤엔 여기서 교대를 기다린다. 옆에 빈 술병 줄."},{"x":23,"y":24,"w":1,"h":1,"text":"침낭 둘. 베개 자리에 '합격 기원' 부적 — 고시원에서 주운 것."},{"x":4,"y":21,"w":1,"h":1,"text":"빨랫줄. 패거리 옷 사이에 2077년 교복 셔츠 하나 — 누구 것인지 아무도 모른다."},{"x":3,"y":33,"w":1,"h":1,"text":"고철 더미. 고시원 문짝 · 책상 다리 · 2077년 독서실 칸막이."},{"x":28,"y":19,"w":1,"h":1,"text":"전봇대. 분양 광고 — '남부순환 패거리 분양: 원룸 한 칸 200. 입주자는 안 쏜다.'"}],"signs":[],"triggers":[],"enemies":[{"id":"CR-420","x":24,"y":20,"cond":"SQ_S02_IN == 1 and GAME_DAY >= SQ_S02_EXILE_DAY + 7 and dead(\"N-R01-039\") == 0 and GC_PASS != GAME_DAY and GC_OWN == 0","who":"N-R01-039","dir":"S","stance":"hold"}],"boxes":[{"x":15,"y":31,"w":1,"h":1,"kind":"gang_goods","owner":"N-R01-060","lock":35,"name":"패거리 창고 — 문구점 앞 상자","cond":""},{"x":42,"y":31,"w":1,"h":1,"kind":"gang_goods","owner":"N-R01-060","lock":35,"name":"패거리 창고 — 컵밥집 앞 상자","cond":""},{"x":44,"y":31,"w":1,"h":1,"kind":"gang_goods","owner":"N-R01-060","lock":0,"name":"컵밥집 앞 둘째 상자(독서실 열쇠 — 2077년 문구 자물쇠)","cond":"GC_KEY == 1"},{"x":3,"y":33,"w