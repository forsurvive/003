:"(샌드백 그늘에 무릎을 끌어안고 앉았다) …누구야. 이자 쪽 사람이야?","look":"M1-S2-HR01-H1-T03-2-PF00-HD00-EY00","sheet":"st_look_m1_s2_hr01_h1_t03_2_pf00_hd00_ey00"}],"texts":[{"x":2,"y":2,"w":1,"h":1,"text":"상인회 달력. 수요일 · 토요일마다 붉은 동그라미 — '이자'. 금요일엔 파란 십자 하나.","cond":"UQ70_JA == 0"},{"x":2,"y":2,"w":1,"h":1,"text":"상인회 달력. 수 · 토 붉은 동그라미 위로 굵게 가위표. 그 옆에 손글씨 '함 — 상인회'.","cond":"UQ70_JA != 0"},{"x":7,"y":2,"w":2,"h":1,"text":"장터 쪽 창. 노점 지붕들 너머로 번호표 창구의 셔터가 보인다."},{"x":1,"y":3,"w":1,"h":1,"text":"서랍 셋. 맨 아래 칸에 2077년 '대림중앙시장 상인회 정관' — 첫 줄 '회원은 서로의 자리를 지킨다'."},{"x":3,"y":4,"w":2,"h":1,"text":"상인회 장부.","scene":"UQ70_LEDGER"},{"x":7,"y":3,"w":2,"h":1,"text":"장부 선반. 해마다 한 권 — 2271년부터 자릿세 칸이 두 줄이 됐다. '상인회' 한 줄, '이자' 한 줄."},{"x":8,"y":8,"w":1,"h":1,"text":"얇은 담요 한 장을 사무실 바닥에 폈다. 상인회장은 장부 옆에서 잔다."},{"x":13,"y":2,"w":2,"h":1,"text":"띠 걸이. 흰 띠부터 빨강 띠까지 — 검정 띠 자리 못만 비었다."},{"x":17,"y":2,"w":3,"h":1,"text":"거울 벽. 먼지에 손바닥 자국 하나 — 최근 거다. 누가 거울 앞에서 자세를 잡아 봤다."},{"x":21,"y":4,"w":1,"h":1,"text":"매단 샌드백. 터진 솔기를 박스 테이프로 감았다. 테이프는 새것이다."},{"x":22,"y":3,"w":1,"h":1,"text":"책장 맨 위 『태권도 품새 교본』 — 손때가 묻었다. 아래 칸에 2077년 승급 심사표 '대림 ○○태권도 — 10월 26일 심사'."},{"x":12,"y":6,"w":1,"h":1,"text":"칸막이 문틀에 키 재기 눈금 — '민준 7살', '민준 8살'. 그 위로 굵은 매직 '수호 21'."}],"signs":[],"triggers":[],"enemies":[],"boxes":[{"x":9,"y":3,"w":1,"h":1,"kind":"uq70_fund","owner":"N-R02-046","lock":0,"name":"자릿세 함(상인회 금고)","cond":""},{"x":1,"y":8,"w":1,"h":1,"kind":"stash","owner":"","lock":0,"name":"맡김 칸(번호 자물쇠 — 장터 사람들이 짐을 맡기는 칸)","cond":""}],"terms":[],"floor":[[3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3],[3,28,28,28,28,28,28,28,28,28,28,3,28,28,28,28,28,28,28,28,28,28,28,3],[3,28,28,28,28,28,28,28,28,28,28,3,28,28,28,28,28,28,28,28,28,28,28,3],[28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28],[28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28],[28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28],[28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28,28],[28,28,28,28,28