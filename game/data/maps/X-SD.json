2_s5_hr03_h2_t10_2_pf00_hd00_ey00_pr040"},{"id":"CR-091","x":22,"y":12,"dir":"W","route":[],"cond":"CARAVAN_V54 == 2 and V_ACT >= 1 and UQ05_ABSENT == 0","bark":"(짐 실은 짐소가 무릎을 꿇고 쉰다.)","sheet":"cr_cr091_loco"},{"id":"CR-091","x":22,"y":12,"dir":"W","route":[],"cond":"CARAVAN_V54 == 2 and V_ACT >= 1 and UQ05_ABSENT == 2","bark":"(빌린 짐소가 무릎 꿇기를 거부한다.)","sheet":"cr_cr091_loco"}],"texts":[{"x":13,"y":4,"w":2,"h":1,"text":"사당역 4번 출구. 계단 아래에서 화덕 연기와 사람 소리가 올라온다."},{"x":11,"y":5,"w":1,"h":1,"text":"모래주머니. 출구 양옆을 지키는 경비 자리."},{"x":3,"y":3,"w":2,"h":1,"text":"사당역 6번 출구. 함석 · 문짝 · 철판을 세워 철사로 묶었다. '4번으로.'"},{"x":22,"y":3,"w":2,"h":1,"text":"사당역 10번 출구. 막혀 있다. 칸막이 틈으로 찬바람이 올라온다."},{"x":13,"y":7,"w":3,"h":1,"text":"현수막. 2호선 녹색 천과 4호선 하늘색 천을 이어 붙였다. '사당 환승촌.' 아래 판자 — '환승객 환영 / 무기는 개찰구 앞에서 내리기.'"},{"x":9,"y":1,"w":2,"h":1,"text":"버스 정류장 표지. '과천 · 남태령 방면.' 시간표 칸에 누가 '200년째 배차 간격'이라고 긁어 놓았다."},{"x":2,"y":9,"w":2,"h":2,"text":"행상 천막. 물통 · 자루 · 깡통. 주인은 계단 아래 내려가 있다."},{"x":5,"y":9,"w":2,"h":2,"text":"행상 천막. 줄무늬 차양. 좌판은 비었고 '수송대 오는 날 엶'."},{"x":2,"y":13,"w":2,"h":2,"text":"행상들이 자는 천막. 짐 자루를 베개 삼았다."},{"x":5,"y":15,"w":2,"h":1,"text":"좌판. 말린 버섯 봉지가 줄지어 있다. 값표 '한 봉 5캡 — 표 주임'."},{"x":9,"y":15,"w":1,"h":1,"text":"드럼통 화덕. 환승촌 사람들이 지상 바람을 쐬러 나와 불 앞에 선다."},{"x":5,"y":6,"w":2,"h":1,"text":"빨랫줄. 버섯 일꾼들 작업복. 지하에선 안 마른다."},{"x":18,"y":11,"w":1,"h":1,"text":"캐러밴 말뚝. 쇠고리마다 밧줄 자국이 반들반들하다. 두 머리 한우를 매는 자리."},{"x":23,"y":11,"w":1,"h":1,"text":"말뚝. 밧줄 끝에 이름표 — '위강윤 대여 · 하루 40캡.'"},{"x":16,"y":11,"w":1,"h":2,"text":"물통 줄. 수송대가 오면 짐소부터 먹인다."},{"x":18,"y":17,"w":2,"h":1,"text":"고철 더미. 칸막이를 고칠 때 쓰려고 모아 둔 함석 · 보닛 · 철판."},{"x":21,"y":15,"w":2,"h":1,"text":"짐 자루. '노들섬 남단 — 조합 창고' 꼬리표."},{"x":22,"y":6,"w":3,"h":2,"text":"버스 잔해. 과천행. 바퀴를 떼어 칸막이 기둥으로 썼다. 안에서 행상들이 비를 피한다."},{"x":7,"y":3,"w":2,"h":1,"text":"지하철 매점 터. 2077년 가격표 — '공보 일보 500원'."},{"x":26,"y":10,"w":1,"h":2,"text":"고철 칸막이. 녹슨 함석 · 자동차 보닛 · 철문짝을 쇠기둥에 철사로 묶었다. 밤엔 들개가 이걸 긁는다."}],"signs":[],"triggers":[],"enemies":[],"boxes":[],"terms":[],"structs":[],"f