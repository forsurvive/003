":3,"w":2,"h":1,"text":"컨테이너 막사. '제7 검문대.' 연통에서 연기가 난다."},{"x":27,"y":7,"w":2,"h":1,"text":"둘째 막사. 문에 자물쇠. 창 철망 너머 2층 침대.","cond":"not (SQ_S06_JIN == 4 and GAME_DAY < SQ_S06_JAIL_DAY + 3)"},{"x":27,"y":7,"w":2,"h":1,"text":"둘째 막사 — 영창. 창 철망 너머 2층 침대 끝에 진해원이 앉아 있다. 무릎을 끌어안고, 창 쪽을 보지 않는다.","cond":"SQ_S06_JIN == 4 and GAME_DAY < SQ_S06_JAIL_DAY + 3"},{"x":23,"y":14,"w":1,"h":1,"text":"분류반 천막. '등록 상담 창구.' 판독기 상자의 호박 불이 깜박인다."},{"x":27,"y":12,"w":2,"h":1,"text":"감시탑. 위에서 망원경이 고개 위 · 사당 쪽을 번갈아 본다."},{"x":27,"y":19,"w":2,"h":1,"text":"새 감시탑. 판자가 아직 하얗다. 수색대가 돌아간 뒤 세웠다.","cond":"PD_R01_BJ > 0"},{"x":24,"y":9,"w":2,"h":1,"text":"게시판.","scene":"SG_BOARD"},{"x":7,"y":21,"w":1,"h":1,"text":"표지. '남태령 너머 — 계엄 차단선. 사격 구역.' 고개 위에서 낙진 바람이 내려온다."}],"signs":[],"triggers":[],"enemies":[],"boxes":[{"x":28,"y":15,"w":1,"h":1,"kind":"crate","owner":"N-R01-047","lock":0,"name":"보급 상자","cond":""},{"x":1,"y":17,"w":1,"h":1,"kind":"car","owner":"","lock":0,"name":"차량 잔해 트렁크","cond":"","auto":true},{"x":29,"y":15,"w":1,"h":1,"kind":"crate","owner":"N-R01-047","lock":0,"name":"군용 상자","cond":"","auto":true},{"x":28,"y":16,"w":1,"h":1,"kind":"sacks","owner":"N-R01-047","lock":0,"name":"쌓인 자루","cond":"","auto":true,"vanish":true}],"terms":[],"structs":[],"auto_boxes":3,"floor":[[3,3,3,3,0,2,6,6,4,4,4,4,4,5,4,4,4,4,4,4,6,6,0,17,17,17,17,17,17,0],[2,3,3,2,0,3,6,6,4,4,4,4,4,5,4,4,4,4,4,4,0,0,17,17,17,17,17,17,17,17],[0,0,3,0,0,3,6,6,4,4,4,4,4,4,4,4,4,4,4,4,6,6,0,17,17,17,17,17,17,17],[3,2,2,3,3,2,6,6,4,4,4,4,4,5,4,4,4,4,4,4,6,0,0,17,17,17,17,17,17,0],[0,0,2,3,2,0,6,6,4,4,4,4,4,5,4,4,4,4,4,4,6,6,17,17,17,0,17,0,17,0],[3,3,3,2,3,0,6,6,4,4,4,4,4,4,4,4,4,4,4,4,6,6,17,17,17,17,17,17,17,17],[3,0,0,0,0,3,6,0,4,4,4,4,4,5,4,4,4,4,4,4,6,6,17,17,17,17,0,17,17,0],[0,0,3,0,2,0,6,6,4,4,4,4,4,5,4,4,4,4,4,4,6,0,17,17,17,17,17,17,3,0],[0,2,0,0,0,3,6,6,4,4,4,4,4,4,4,4,4,4,4,4,0,6,17,17,17,17,17,17,17,0],[0,0,0,2,0,3,0,6,4,4,4,4,4,5,4,4,4,4,4,4,6,0,17,17,17,17,17,17,17,0],[0,2,3,0,3,2,6,6,4,4,4,4,4,5,4,4,4,4,4,4,6,6,0,