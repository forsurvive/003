:"UQ69_DIE == 3"},{"x":5,"y":14,"w":1,"h":1,"text":"리어카. 바퀴 축에 기름이 번들거린다. 손잡이에 '성씨 — 빌려 가면 죽는다'."},{"x":12,"y":15,"w":1,"h":1,"text":"모루. 골목 공용 — 쇳덩이 하나가 식다 만 채 올려져 있다."},{"x":31,"y":15,"w":1,"h":1,"text":"드럼통 불. 철공소 사람들이 퇴근하며 손을 녹인다. 아침엔 쇳가루가 불 위로 날린다."},{"x":36,"y":14,"w":1,"h":1,"text":"협동조합 공구 사물함. 칸마다 자물쇠 — 빈 칸 하나에 '성씨에게 말하면 빌려줌'.","scene":"MR_LOCKER"},{"x":16,"y":9,"w":1,"h":1,"text":"골목 입간판 '부품'. 그 아래 분필로 '총 고쳐 드립니다 · 총열 새로 뽑음(금형 있을 때)'. 괄호 안은 나중에 덧쓴 글씨."},{"x":6,"y":9,"w":1,"h":1,"text":"성씨 선반 바깥 작업대. 숫돌 · 줄칼 · 식은 쇠토막. 손님 총은 여기서 먼저 들여다본다."},{"x":31,"y":9,"w":1,"h":1,"text":"용두식 금형 앞 좌판. 나사 · 스프링 · 공이 — 칸마다 분필 값. 주인은 안에서 나오지 않는다."},{"x":37,"y":10,"w":1,"h":1,"text":"협동조합 게시판. '수레 대여 — 성씨 · 용접 — 연 · 금형 — 용 · 밤 10시 이후 망치질 금지'."}],"signs":[],"triggers":[],"enemies":[],"boxes":[{"x":8,"y":15,"w":2,"h":1,"kind":"trash","owner":"","lock":0,"name":"고철 더미","cond":"","vanish":true},{"x":27,"y":15,"w":2,"h":1,"kind":"trash","owner":"","lock":0,"name":"고철 더미","cond":"","vanish":true},{"x":35,"y":14,"w":1,"h":1,"kind":"mr_locker","owner":"","lock":0,"name":"공구 사물함","cond":"MR_LOCKER == 1"},{"x":23,"y":14,"w":1,"h":1,"kind":"toolbox","owner":"","lock":0,"name":"작업대 서랍","cond":"","auto":true},{"x":13,"y":15,"w":1,"h":1,"kind":"trash","owner":"","lock":0,"name":"쓰레기통","cond":"","auto":true},{"x":20,"y":14,"w":1,"h":1,"kind":"sacks","owner":"","lock":0,"name":"쌓인 자루","cond":"","auto":true,"vanish":true}],"terms":[],"structs":[{"kind":"tin_roof","x":1,"y":0,"w":13,"h":6,"seed":1,"args":{"edges":"nwe"}},{"kind":"steel_shed","x":1,"y":6,"w":13,"h":2,"seed":2,"args":{"doors":[[7,"shutter"]],"sign":"성씨 선반","sub":"총열 · 선반 · 무기 개조","beams":2}},{"kind":"tin_roof","x":14,"y":0,"w":12,"h":6,"seed":3,"args":{"edges":"nwe"}},{"kind":"steel_shed","x":14,"y":6,"w":12,"h":2,"seed":4,"args":{"doors":[[7,"steel"]],"sign":"연 용접","sub":"방어구 수리 · 철판 · 용접","beams":2}},{"kind":"tin_roof","x":26,"y":0,"w":13,"h":6,"seed":5,"args":{"edges":"nwe","skylights":true}},{"kind":"steel_shed","x":26,"y":6,