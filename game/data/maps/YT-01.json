:11,"w":2,"h":1,"text":"3동 게이트(빨강). 판독 판에 '3동 — 본사 등급'. 날개 유리에 손바닥 자국이 겹겹이 — 안쪽이 아니라 바깥쪽에서.","scene":"YT_GATE3"},{"x":18,"y":14,"w":2,"h":1,"text":"안내 데스크. 방문객 명부 마지막 장 '10/23 22:10 · 남기범(2동 세진협력) · 3동 송출실 심부름'. 그 아래 줄은 비었다."},{"x":36,"y":12,"w":2,"h":1,"text":"커튼월 유리가 깨진 자리. 바람이 로비 안으로 분다. 밖으로 금탑이 보인다."},{"x":22,"y":17,"w":2,"h":1,"text":"로비 소파. 해진 정장 차림 구울이 낮이면 여기 앉아 존다 — 목에 빨강 사원증이 흔들린다.","scene":"YT_CLERK"},{"x":25,"y":13,"w":1,"h":1,"text":"로비 소파 옆 유해. 사원증 줄만 남고 카드는 없다. 누가 먼저 가져갔다."},{"x":4,"y":7,"w":2,"h":1,"text":"1동 연결 통로. 천장 판과 유리가 무너져 통로를 메웠다. 그 아래 우산 하나."},{"x":17,"y":3,"w":3,"h":1,"text":"판독 로그 화면. 녹색 글자가 아직 흐른다 — '23:21 관제망 집행 모드 · 등급 필터 가동 · 이후 발급분 무효'. 그 위 줄 '22:40 임시 발급 1건(3동) 2동 인사'.","scene":"YT_LOG"},{"x":20,"y":5,"w":1,"h":1,"text":"승강기 비상 전지 함. 바늘이 0에 붙었다. 손잡이에 '집행 모드 — 승강기 운행 중지(23:21)'. 다시 올릴 수 있을 것 같다.","scene":"YT_POWER"},{"x":27,"y":3,"w":2,"h":1,"text":"3동 승강기. 층 표시등이 꺼졌다. 호출 단추 옆 빨강 판독기. 문 아래쪽이 손톱 자국으로 하얗게 긁혀 있다.","scene":"YT_ELEV"},{"x":37,"y":3,"w":1,"h":1,"text":"비상 계단 철문 옆 빨강 판독기. '3동 직원 외 출입 금지 — 계단 이용 시에도 판독'.","scene":"YT_STAIR"},{"x":31,"y":5,"w":2,"h":1,"text":"벽 층 안내. '18층 — 시세 송출실(세진 금융정보)'. 그 아래 손글씨 '당번 도미란 대리 내선 1802'."},{"x":19,"y":21,"w":2,"h":1,"text":"멈춘 에스컬레이터. 계단처럼 걸어 내려간다. 손잡이 고무가 녹아 손에 묻는다."},{"x":4,"y":25,"w":2,"h":1,"text":"다시 문 연 김밥집 연탄 화로 위 은박 냄비. 벽에 '김밥 한 줄 — 병뚜껑 5'."},{"x":14,"y":24,"w":1,"h":1,"text":"구두 수선 부스. 구두약 통에 '세진 2동 김 과장님 — 10/24 찾아가세요'."},{"x":24,"y":26,"w":2,"h":1,"text":"편의점 터. 진열대는 거의 비었다. 계산대 위 영수증 '10/23 22:31 컵라면 1 · 삼각김밥 1 — 남기범'."},{"x":6,"y":29,"w":2,"h":1,"text":"2동 연결 게이트(파랑). '2동 — 협력사 등급 이상'. 날개 너머 2동 계단.","scene":"YT_GATE2"},{"x":34,"y":29,"w":2,"h":1,"text":"연결 통로 셔터 뒷면.","scene":"YT_SHUT_BACK"},{"x":34,"y":28,"w":2,"h":1,"text":"증권가 연결 통로 방화 셔터. 빨강 판독기 하나. 셔터 아래 바닥에 '객장 방면 →' 화살표가 반쯤 보인다.","scene":"YT_SHUT"}],"signs":[],"triggers":[],"enemies":[{"id":"CR-200","x":21,"y":16,"cond":"dead(\"N-YTB-1\") == 0 and YT_CUP == 0","who":"N-YTB-1"}],"boxes":[{"x":13,"y":4,"w":2,"h":1,"kind":"yt_gu