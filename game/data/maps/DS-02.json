xt":"그릴이 성에로 하얗게 덮였다. 바람이 칼처럼 차다.","cond":"UQ04_COLD == 1"},{"x":36,"y":10,"w":1,"h":1,"text":"7호 번호 자물쇠.","scene":"UQ04_PAD"},{"x":34,"y":11,"w":1,"h":1,"text":"두꺼운 단열 문. '7 — 군 납품 · 관계자 외 출입 금지'. 문틈에서 하얀 김이 샌다.","cond":"UQ04_OPEN == 0"},{"x":29,"y":4,"w":5,"h":1,"text":"7호 비축 선반.","scene":"UQ04_SHELF"},{"x":29,"y":6,"w":2,"h":1,"text":"7호 비축 선반.","scene":"UQ04_SHELF"},{"x":40,"y":4,"w":1,"h":1,"text":"냉동기 제어반.","scene":"UQ04_PANEL"},{"x":38,"y":2,"w":1,"h":1,"text":"출고 단말.","scene":"UQ04_TERM"},{"x":36,"y":6,"w":2,"h":1,"text":"언 왕쥐.","cond":"UQ04_RATK == 3","scene":"UQ04_RATK"},{"x":12,"y":18,"w":1,"h":1,"text":"고기 사냥꾼의 유해. 허리춤 수첩 마지막 장 — '독산 1~6호 꽝. 7호는 번호. 구로 차량기지 냉동차 — 거긴 아직 얼어 있다고 함. 다음엔 거기.'"},{"x":20,"y":20,"w":1,"h":1,"text":"파리 떼 윙윙 소리가 귀를 덮는다. 제 발소리도 안 들린다 — 쥐도 못 듣겠지.","cond":"UQ04_COLD == 0"},{"x":20,"y":20,"w":1,"h":1,"text":"파리가 바닥에 떨어져 언 채 깔렸다. 조용하다. 너무 조용하다.","cond":"UQ04_COLD == 1"},{"x":28,"y":15,"w":1,"h":1,"text":"6호 바닥이 꺼져 흙이 드러났다. 흙이 군데군데 봉긋하다 — 무언가 밑에서 다닌다.","cond":"UQ04_COLD == 0"},{"x":28,"y":15,"w":1,"h":1,"text":"6호 흙이 얼어 돌처럼 굳었다. 봉긋한 자리마다 흙이 갈라졌다.","cond":"UQ04_COLD == 1"},{"x":37,"y":18,"w":2,"h":1,"text":"냉동 화물칸.","scene":"UQ04_WAGON"},{"x":45,"y":18,"w":1,"h":1,"text":"화물 철로가 셔터 밑으로 이어진다. 셔터가 반쯤 들려 바깥 빛이 샌다 — 옛 화물 철로 쪽으로 나갈 수 있다."},{"x":29,"y":12,"w":2,"h":1,"text":"엎어진 상인회 수레. 바퀴 하나가 아직 헛돈다. 손잡이에 짐표 '독산 7호 · 함', 문턱까지 끌린 핏자국.","cond":"UQ04_JH == 4"}],"signs":[],"triggers":[{"x":28,"y":11,"w":3,"h":2,"scene":"UQ04_FEUD","cond":"UQ04_FEUD == 1","once":false}],"enemies":[{"id":"CR-097","x":22,"y":5,"cond":"UQ04_RATK == 0","boss":true},{"id":"CR-097","x":36,"y":5,"cond":"UQ04_RATK == 4"},{"id":"CR-095","x":19,"y":4,"cond":"UQ04_COLD == 0"},{"id":"CR-095","x":25,"y":3,"cond":"UQ04_COLD == 0"},{"id":"CR-095","x":24,"y":6,"cond":"UQ04_COLD == 0"},{"id":"CR-096","x":20,"y":6,"cond":"UQ04_COLD == 0"},{"id":"CR-096","x":14,"y":6,"cond":""},{"id":"CR-096","x":28,"y":18,"cond":""},{"id":"CR-095","x":42,"y":18,"cond":""},{"id":"CR-095","x":9,"y":1