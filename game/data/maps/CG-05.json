8,"y":15,"px":[1215,457],"sort_y":512},{"name":"file_cabinet","x":38,"y":16,"px":[1215,489],"sort_y":544},{"name":"display_case","x":25,"y":11,"px":[799,335],"sort_y":384},{"name":"chair_n","x":31,"y":16,"px":[999,523],"sort_y":528},{"name":"plant_pot","x":24,"y":20,"px":[768,619],"sort_y":672},{"name":"plant_pot","x":38,"y":20,"px":[1216,619],"sort_y":672},{"name":"w_photo","x":35,"y":8,"px":[1122,261],"sort_y":320}],"doors":[{"x":3,"y":1,"kind":"door_slide","label":"승강기 홀","locked":true}],"exits":[],"marks":{"arrive":[6,12,"S"],"from_elev":[3,3,"S"],"office_in":[31,15,"N"],"guest_door":[6,10,"S"],"sec_desk":[17,15,"N"]},"npcs":[{"id":"CR-401","x":2,"y":4,"dir":"E","route":[],"cond":"","bark":"귀빈께서는 이 층에만 계십니다. 필요하신 건 비서실에 말씀하십시오.","sheet":"en_cr401_loco"},{"id":"CR-401","x":4,"y":4,"dir":"W","route":[],"cond":"","bark":"승강기는 권한대행님 결재가 있어야 움직입니다.","sheet":"en_cr401_loco"},{"id":"N-R11-024","x":34,"y":4,"dir":"W","route":[],"cond":"","bark":"권한대행님 면담 때는 문밖에 서 있겠습니다. 저를 신경 쓰실 필요는 없습니다."},{"id":"CR-405","x":37,"y":5,"dir":"W","route":[],"cond":"","bark":"……(파워 아머 안에서 숨소리만 들린다)","sheet":"en_cr405_loco"},{"id":"CR-405","x":31,"y":3,"dir":"S","route":[],"cond":"","bark":"……(헬멧 렌즈가 천천히 당신을 따라 돈다)","sheet":"en_cr405_loco"},{"id":"N-R11-005","x":17,"y":12,"dir":"S","route":[],"cond":"","bark":"권한대행님은 서두르지 않으십니다. 서류는 서두르지 않으니까요."},{"id":"C-003","x":31,"y":13,"dir":"S","route":[],"cond":"","bark":""}],"texts":[{"x":3,"y":2,"w":1,"h":1,"text":"승강기 홀로 가는 철문. 밖에서 잠겼다. '귀빈께서는 이 층에만 계십니다.'"},{"x":9,"y":2,"w":2,"h":1,"text":"비상정부 공고. '충성 등급 확인은 C04 등록관리실. 등급 밖 인원은 이 층 출입을 금한다.'"},{"x":14,"y":2,"w":1,"h":1,"text":"액자. 2078년 권한대행 취임 선서. 사진 속 사람들 가운데 지금 살아 있는 사람은 하나뿐이다."},{"x":21,"y":3,"w":1,"h":1,"text":"냉수기. 물이 차갑다. 벙커 원자로가 아직 돈다는 뜻이다."},{"x":36,"y":3,"w":2,"h":1,"text":"근위대 무기함. 자물쇠 셋. 손대면 안 되는 물건이라는 게 한눈에 보인다."},{"x":2,"y":11,"w":1,"h":2,"text":"각 잡힌 침대. 모포의 휘장이 정확히 가운데에 있다. 누군가 자로 쟀다."},{"x":3,"y":9,"w":2,"h":1,"text":"창. 아니, 창틀에 끼운 사진이다. 2077년 봄 한강. 지하 60미터에서 보는 바깥."},{"x":9,"y":9,"w":1,"h":1,"text":"공보방송 스피커. 끄는 손잡이가 없다. 정시마다 '대한민국 비상정부는 국민 여러분과 함께 있습니다.'"},{"x":6,"y":15,"w":1,"h":1,"text":"찻상. 찻주전자가 아직 따뜻하다. 잔은 둘. 누군가 마주 앉을 줄 안다.","scene":"CG-05_TEA"},{"x":1,"y":19,"w":1,"h":1,"text":"세면대. 수건이 접혀 있다. 비누에 '비상정부 보급' 각인."},{"x":11,"y":20,"w":1,"h":1,"text":"책장. 2077년 판 '공무원 복무 규정'과 '귀빈 응대 요령'이 나란히 꽂혀 있다."},{"x":16,"y":13,"w":2,"h":1,"text":"타자기에 서식이 물려 있다. '면담 기록 — 관리자 후보 1순위.' 아래는 아직 비었다."},{"x":14,"y":9,"w":1,"h":1,"text":"2277년 10월 달력. 23일 칸에 붉은 글씨 '200주년 — 23:29 묵념.' 26일 칸에 연필로 '관리자 후보?'"},{"x":14,"y":18,"w":2,"h":1,"text":"대기 의자. 앉는 자리가 반들반들하다. 여기서 기다린 사람이 많았다."},{"x":22,"y":20,"w":1,"h":1,"text":"화분. 조화다. 먼지를 닦은 자국이 있다."},{"x":30,"y":14,"w":3,"h":1,"text":"권한대행 책상.","scene":"CG-05_DESK"},{"x":27,"y":11,"w":1,"h":1,"text":"깃대 둘. 태극기와, 별이 열세 개인 성조기. 2077년엔 둘이 나란히 걸리는 게 당연했다."},{"x":31,"y":9,"w":1,"h":1,"text":"벽시계. 23시 29분. 초침이 없다. 일부러 뺀 것 같다."},{"x":38,"y":11,"w":1,"h":6,"text":"서류함 여섯. 서랍마다 날짜 표. 마지막 서랍의 마지막 날짜는 '2077. 10. 23. 23:21.'"},{"x":25,"y":11,"w":1,"h":1,"text":"진열장. 상아 손잡이 권총 한 자루와 국무위원 배지 일곱 자리. 배지는 셋뿐이다. 자물쇠가 아주 단단하다."},{"x":35,"y":9,"w":1,"h":1,"text":"액자. 2077년 국무회의 사진. 일곱 자리 가운데 넷이 오려져 있다."}],"signs":[],"triggers":[],"enemies":[],"boxes":[{"x":9,"y":10,"w":1,"h":1,"kind":"cabinet","owner":"","lock":0,"name":"귀빈실 서랍장","cond":""},{"x":11,"y":19,"w":1,"h":1,"kind":"desk","owner":"","lock":0,"name":"귀빈실 책장","cond":""},{"x":19,"y":10,"w":3,"h":1,"kind":"cabinet","owner":"N-R11-005","lock":0,"name":"비서실 서류함","cond":""}],"terms":[],"floor":[[3,3,31,31,31,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3],[3,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,34,34,34,34,34,34,34,34,34,3],[3,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,34,34,34,34,34,34,34,34,34,3],[31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,34,34,34,34,34,34,34,34,34,34],[31,31,31,31,31,31,31,31,31,31,31,31,31,31,31,31