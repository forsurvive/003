{"id":"HP-04","name":"여의도 대학병원 2층 안과","set":"bk","size":[24,14],"props":[{"name":"w_eye_chart","x":20,"y":1,"px":[642,33],"sort_y":96},{"name":"slit_lamp","x":16,"y":3,"px":[513,85],"sort_y":128},{"name":"wait_chairs","x":19,"y":8,"px":[608,249],"sort_y":288},{"name":"wait_chairs","x":19,"y":10,"px":[608,313],"sort_y":352},{"name":"w_pa_hp","x":14,"y":1,"px":[447,33],"sort_y":96},{"name":"op_table","x":7,"y":6,"px":[223,189],"sort_y":224},{"name":"op_scope","x":5,"y":5,"px":[155,129],"sort_y":192,"cond":"UQ08_LENS == 0","cells":[[5,5]]},{"name":"op_scope","x":5,"y":5,"px":[155,129],"sort_y":192,"state":"taken","cond":"UQ08_LENS != 0","cells":[[5,5]]},{"name":"lens_case","x":2,"y":3,"px":[64,89],"sort_y":128,"state":"taken"},{"name":"rubble","x":3,"y":10,"px":[94,323],"sort_y":352},{"name":"rubble","x":2,"y":11,"px":[62,355],"sort_y":384}],"doors":[],"exits":[{"x":20,"y":13,"to":"HP-01","mark":"from_HP04"},{"x":21,"y":13,"to":"HP-01","mark":"from_HP04"}],"marks":{"from_HP01":[20,12,"N"]},"npcs":[],"texts":[{"x":20,"y":3,"w":1,"h":1,"text":"시력표. 맨 아래 줄은 아무도 못 읽었을 것이다 — 줄 위에 누가 손톱으로 '1.0'을 긁어 놓았다."},{"x":16,"y":3,"w":2,"h":1,"text":"세극등 진료대. 턱받침에 이마 띠 자국이 남았다. 이 대물렌즈는 금이 갔다 — 쓸 수 없다."},{"x":19,"y":9,"w":2,"h":1,"text":"대기 의자. 접수 번호표 '외래 214'가 의자 틈에 끼어 있다. 2077. 10. 23. 오후 예약."},{"x":14,"y":3,"w":1,"h":1,"text":"벽 스피커. 선이 잘려 늘어졌다. 이 층엔 차임이 울리지 않는다."},{"x":13,"y":7,"w":1,"h":1,"text":"수술실 문턱. 바닥에 끌린 자국이 수술실 안쪽으로 이어진다. 끝에 수술용 확대경 끈 하나 — 머리띠째 끊어졌다."},{"x":7,"y":6,"w":2,"h":1,"text":"안과 수술대. 머리 받침 고리가 조여진 채다. 시트가 반쯤 찢겨 흘러내렸다."},{"x":5,"y":5,"w":1,"h":1,"text":"안과 수술 현미경.","scene":"UQ08_SCOPE"},{"x":2,"y":3,"w":1,"h":1,"text":"렌즈 보관장. 쟁반 셋 가운데 둘은 깨진 유리뿐. 남은 렌즈는 도수가 맞지 않는 안경알이다. 쟁반 이름표 — '세진 광학 · 수술 현미경 예비'(빈 칸)."},{"x":3,"y":10,"w":2,"h":1,"text":"무너진 천장. 빗물이 고여 바닥 타일이 들떴다. 위층 병동 침상 다리가 내려다보인다."}],"signs":[],"triggers":[],"enemies":[{"id":"CR-200","x":18,"y":6,"cond":"dead(\"N-HP-F6\") == 0","who":"N-HP-F6","route":[[18,6,4.0],[15,10,3.0],[20,4,3.0]]},{"id":"CR-200","x":9,"y