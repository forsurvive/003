## SD-12 §14.1 판정 표 전 행 (SD-19 §5.2 완료 기준: 조사 함수 단위 시험 100%)
extends RefCounted


func test_pairs_table(t) -> void:
	# [조사 코드, 받침 있음 예, 받침 없음 예, ㄹ 받침 예] -> 기대값
	var rows := [
		["은", "서윤", "서윤은", "하나", "하나는", "볼트 S-07의 철", "볼트 S-07의 철은"],
		["는", "서윤", "서윤은", "하나", "하나는", "길", "길은"],
		["이", "봉천", "봉천이", "사이다", "사이다가", "물", "물이"],
		["가", "봉천", "봉천이", "사이다", "사이다가", "물", "물이"],
		["을", "스팀팩", "스팀팩을", "라드어웨이", "라드어웨이를", "쌀", "쌀을"],
		["를", "스팀팩", "스팀팩을", "라드어웨이", "라드어웨이를", "쌀", "쌀을"],
		["과", "백구", "백구와", "조만석", "조만석과", "할", "할과"],
		["와", "조만석", "조만석과", "백구", "백구와", "말", "말과"],
		["으로", "남산", "남산으로", "여의도", "여의도로", "서울", "서울로"],
		["로", "남산", "남산으로", "여의도", "여의도로", "서울", "서울로"],
		["이나", "캡", "캡이나", "배급표", "배급표나", "쌀", "쌀이나"],
		["나", "캡", "캡이나", "배급표", "배급표나", "쌀", "쌀이나"],
		["이랑", "엄마", "엄마랑", "동생", "동생이랑", "할", "할이랑"],
		["랑", "동생", "동생이랑", "엄마", "엄마랑", "별", "별이랑"],
		["아", "서윤", "서윤아", "하나", "하나야", "솔", "솔아"],
		["야", "서윤", "서윤아", "하나", "하나야", "솔", "솔아"],
		["이다", "볼트", "볼트다", "봉천", "봉천이다", "서울", "서울이다"],
		["다", "봉천", "봉천이다", "볼트", "볼트다", "서울", "서울이다"],
		["이에요", "봉천", "봉천이에요", "볼트", "볼트예요", "서울", "서울이에요"],
		["예요", "볼트", "볼트예요", "봉천", "봉천이에요", "서울", "서울이에요"],
		["이었", "봉천", "봉천이었", "볼트", "볼트였", "서울", "서울이었"],
		["였", "볼트", "볼트였", "봉천", "봉천이었", "서울", "서울이었"],
		["이라", "봉천", "봉천이라", "볼트", "볼트라", "서울", "서울이라"],
		["라", "볼트", "볼트라", "봉천", "봉천이라", "서울", "서울이라"],
		["이든", "봉천", "봉천이든", "볼트", "볼트든", "서울", "서울이든"],
		["든", "볼트", "볼트든", "봉천", "봉천이든", "서울", "서울이든"],
	]
	for r in rows:
		for k in [1, 3, 5]:
			t.eq(r[k] + Josa.pick(r[0], r[k]), r[k + 1], "%s + \\J[%s]" % [r[k], r[0]])


func test_hangul_rule(t) -> void:
	t.eq(Josa.batchim("가"), Josa.NONE)
	t.eq(Josa.batchim("각"), Josa.HAS)
	t.eq(Josa.batchim("갈"), Josa.RIEUL)
	t.eq(Josa.batchim("힣"), Josa.HAS)


func test_numbers(t) -> void:
	var cases := {"1": "로", "2": "로", "3": "으로", "4": "로", "5": "로", "6": "으로", "7": "로", "8": "로", "9": "로",
		"10": "으로", "100": "으로", "1,000": "으로", "10000": "으로", "0": "으로", "S-07": "로", "300": "으로", "21": "로"}
	for k in cases:
		t.eq(Josa.pick("으로", k), cases[k], "숫자 " + k)
	t.eq(Josa.pick("은", "300캡"), "은", "숫자 뒤 한글은 한글 규칙")
	t.eq(Josa.pick("이", "2"), "가", "2 이 -> 가")
	t.eq(Josa.pick("을", "3"), "을", "3 삼 -> 을")


func test_latin(t) -> void:
	t.eq(Josa.pick("으로", "HALL"), "로", "L -> ㄹ")
	t.eq(Josa.pick("은", "R"), "은", "R -> ㄹ")
	t.eq(Josa.pick("이", "ROM"), "이", "M -> 받침")
	t.eq(Josa.pick("을", "SEJIN"), "을", "N -> 받침")
	t.eq(Josa.pick("는", "TV"), "는", "그 밖 -> 없음")


func test_brackets(t) -> void:
	t.eq(Josa.pick("은", "볼트(S-07)"), "는", "괄호 안을 건너뛴다")
	t.eq(Josa.pick("을", "『교본』"), "을", "책 괄호")
	t.eq(Josa.pick("이", "'번개사이다'"), "가", "따옴표")


func test_unknown(t) -> void:
	t.eq(Josa.pick("은", "★"), "은(는)", "판정 불가 -> 병기형")
	t.eq(Josa.pick("을", ""), "을(를)", "빈 문자열 -> 병기형")


func test_apply(t) -> void:
	t.eq(Josa.apply("서윤\\J[은] 관악에서 왔다."), "서윤은 관악에서 왔다.")
	t.eq(Josa.apply("하나\\J[은] 관악에서 왔다."), "하나는 관악에서 왔다.")
	t.eq(Josa.apply("라드어웨이\\J[을] 얻었습니다."), "라드어웨이를 얻었습니다.")
	t.eq(Josa.apply("볼트 S-07\\J[으로] 돌아간다."), "볼트 S-07로 돌아간다.")
