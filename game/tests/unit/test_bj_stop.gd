## 1-12l: 계엄군 초소 정지 판정(D-081 · D-118) · 새벽인력 승계(D-082) · 쪽방 통로 위기(D-083)
extends RefCounted


func _st() -> StoryState:
	var st := StoryState.new()
	st.load_data()
	st.vars.set_v("V_ACT", 1)
	st.vars.set_v("AFF_BJ", -30)
	return st


func test_bj_stop_kind(t) -> void:
	var st := _st()
	t.eq(BjStop.kind(st, "SG", 12), 0, "MQ-106 전 · 경계: 검문소는 세우지 않는다(추적대 몫)")
	st.vars.set_v("MQ106_RESULT", 1)
	t.eq(BjStop.kind(st, "SG", 12), 1, "수색대와 싸웠다 = 도주 관리자")
	t.eq(BjStop.kind(st, "NR", 2), 1, "밤에도(우두머리 대신 계엄병)")
	st.vars.set_v("AFF_BJ", 25)
	t.eq(BjStop.kind(st, "SG", 12), 0, "우호 이상은 등록증을 보고 통과")
	st.vars.set_v("AFF_BJ", -70)
	t.eq(BjStop.kind(st, "YD", 12), 3, "적대 = 경고")
	st.vars.set_v("AFF_BJ", -30)
	st.vars.set_v("MQ106_RESULT", 2)
	t.eq(BjStop.kind(st, "YD", 12), 0, "MQ-104 전엔 여의도 문서 검문 없음")
	st.quests.set_stage("MQ-104", 100)
	t.eq(BjStop.kind(st, "YD", 12), 4, "MQ-104 뒤 낮 · 숨음(2) = 여의도 초소 문서 검문")
	t.eq(BjStop.kind(st, "YD", 21), 0, "문서 검문은 낮만")
	t.eq(BjStop.kind(st, "NR", 12), 0, "다리목은 문서 검문을 하지 않는다")
	st.vars.set_v("MQ106_RESULT", 4)
	t.eq(BjStop.kind(st, "YD", 12), 0, "걸어 들어감 = '관리자 후보' 통과")
	st.vars.set_v("MQ106_RESULT", 0)
	st.vars.set_v("MQ104_SEARCH", 4)
	t.eq(BjStop.kind(st, "YD", 12), 0, "선우진을 말로 돌려보냈다 = 초소 병사 통과(MQ-104 기울기 체감)")
	st.vars.set_v("V_ACT", 0)
	st.vars.set_v("MQ106_RESULT", 1)
	t.eq(BjStop.kind(st, "SG", 12), 0, "프롤로그엔 없음")


func test_bj_stop_heir(t) -> void:
	var st := _st()
	var h := InteriorHost.new()
	h.st = st
	h._ready()
	var p := Act1Paths.new()
	p.setup(h, false)
	st.vars.set_v("GAME_DAY", 5)
	p._on_day(5)
	t.eq(int(st.vars.get_v("SB_HDC_DAY")), 0, "황두칠이 살아 있으면 없음")
	st.kill("C-013")
	p._on_day(5)
	t.eq(int(st.vars.get_v("SB_HDC_DAY")), 5, "죽은 날")
	st.vars.set_v("GAME_DAY", 7)
	p._on_day(7)
	t.eq(int(st.vars.get_v("SB_HEIR")), 0, "사흘 전엔 승계 없음")
	st.vars.set_v("GAME_DAY", 8)
	p._on_day(8)
	t.eq(int(st.vars.get_v("SB_HEIR")), 1, "사흘 뒤 독사")
	st.kill("C-021")
	st.vars.set_v("GAME_DAY", 9)
	p._on_day(9)
	t.eq(int(st.vars.get_v("SB_HEIR")), 2, "승계한 독사가 죽으면 구만호")
	st.kill("C-049")
	p._on_day(10)
	t.eq(int(st.vars.get_v("SB_HEIR")), 9, "구만호도 없으면 잇는 사람 없음")
	var st2 := _st()
	var h2 := InteriorHost.new()
	h2.st = st2
	h2._ready()
	var p2 := Act1Paths.new()
	p2.setup(h2, false)
	st2.vars.set_v("GAME_DAY", 3)
	st2.kill("C-013")
	st2.kill("C-021")
	p2._on_day(3)
	st2.vars.set_v("GAME_DAY", 6)
	p2._on_day(6)
	t.eq(int(st2.vars.get_v("SB_HEIR")), 2, "독사도 없으면 구만호")
	h.queue_free()
	h2.queue_free()
	p.free()
	p2.free()
